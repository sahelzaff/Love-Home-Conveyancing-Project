a.put("/analytics/app/common/oneplatform/ui/feedback_component.html",'<div ng-if="!$ctrl.isComplete"\n    ng-repeat="step in $ctrl.feedback.gaMetaData.steps track by $index"\n    ng-show="$ctrl.currentStep === $index">\n  <div ng-if="step.freeform">\n    <section>\n      <span>{{step.freeform.prompt}}</span>\n      <md-input-container md-no-float class="free-form-input-container">\n        <label>{{step.freeform.label}}</label>\n        <textarea class="freeform-feedback" ng-model="$ctrl.responses[$index].freeform"\n                  cols="50"\n                  ng-change="$ctrl.refreshButtons()"\n                  placeholder="{{step.freeform.placeholder}}">\n        </textarea>\n      </md-input-container>\n    </section>\n  </div>\n  <div class="rating" ng-if="step.thumbs" flex\n    layout="row"\n    layout-align="start center">\n    <span flex>{{step.thumbs.prompt}}</span>\n    <md-button md-no-ink class="md-icon-button thumb-up"\n               ng-click="$ctrl.onThumbsUp()">\n      Yes\n    </md-button>\n    <span class="feedback-separator">/</span>\n    <md-button md-no-ink class="md-icon-button thumb-down"\n               ng-click="$ctrl.onThumbsDown()">\n      No\n    </md-button>\n  </div>\n  <div ng-if="step.choice">\n    <section>\n      <span flex>{{step.choice.prompt}}</span>\n      <md-radio-group class="md-primary" ng-model="$ctrl.responses[$index].choice"\n                  ng-change="$ctrl.refreshButtons()">\n        <md-radio-button ng-repeat="choice in step.choice.choices" value="{{choice}}">\n          {{choice}}\n        </md-radio-button>\n      </md-radio-group>\n    </section>\n  </div>\n</div>\n<section flex layout="row" layout-align="end center" ng-if="!$ctrl.isComplete">\n  <span flex class="step" ng-if="$ctrl.stepText">\n    {{$ctrl.stepText}}\n  </span>\n  <md-button md-no-ink\n              class="cancel-button"\n              ng-if="$ctrl.isCancelVisible"\n              ng-click="$ctrl.onCancel()">\n    Cancel\n  </md-button>\n  <md-bu