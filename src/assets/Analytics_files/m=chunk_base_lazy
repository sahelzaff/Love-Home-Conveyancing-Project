a.put("/analytics/app/activities/mobile/reports/attribution/conversion_event_table.ng.html",'<ga-report-header-v2 *ngIf="(tabLabel$ | async) as tabLabel"\n                     [hideDatePicker]="false"\n                     [comparisonEnabled]="true"\n                     [hideFilter]="true"\n                     [isHeaderInAdmin]="isPageInAdmin"\n                     [disableAddComparison]="true"\n                     [hideShareButton]="true"\n                     [singleStep]="false"\n                     [showDateRangeComparison]="true"\n                     [reportTitle]="tabLabel"\n                     [class.conversion-event-table-header-spacing]="isPageInAdmin"\n                     [raptureArticleId]="raptureArticleId">\n</ga-report-header-v2>\n\n<div class="conversion-event-table-wrapper"\n     [class.conversion-event-table-wrapper-spacing]="!isPageInAdmin">\n  <ga-announcements [pageId]="pageId"></ga-announcements>\n\n  <ga-quota-callout [type]="EntityQuotaType.CUSTOM_CONVERSION_EVENT"\n                    class="attribution-conversion-callout">\n  </ga-quota-callout>\n\n  <xap-card class="basic-table-card container-card conversion-event-table-card">\n    <div>\n      <basic-table *ngIf="(attributionTableTabs$ | async) as attributionTableTabs"\n                  [dataSource]="dataSource"\n                  [disableRowClick]="isInGafe"\n                  [displayedColumns]="(conversionEventColumns$ | async) || []"\n                  [disableSearch]="true"\n                  [hideSearch]="true"\n                  [pageSize]="10"\n                  [pageSizeOptions]="[10, 25, 50]"\n                  [tabs]="(isGa4RollupOrSubProperty$ | async) ? [] : attributionTableTabs"\n                  (onRowClick)="viewConversionEvent($event.conversionName)"\n                  (onTabSelectChange)="navigateToNetworkSettingsTable()"\n                  class="conversion-event-table">\n        <div basic-table-header class="conversion-event-table-header">\n          <button m