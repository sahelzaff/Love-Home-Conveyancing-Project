a.put("/analytics/app/activities/admin/goals/wizard/subforms/num-pages.html",'<div class="ID-goals-wizard-numPages-form">\n  <div class="ga-form-item"\n       ng-init="greaterThanOption = ctrl.getGreaterThanComparisonTypeOption()">\n    <div class="content">\n      <span class="goals-wizard-details-inline-label">\n        <span class="label" id="num_pages_screens">\n          Pages/Screens per session\n        </span>\n      </span>\n\n      <ga-select-dropdown\n          items="::greaterThanOption"\n          ng-model="ctrl.goal.pagesPerVisit.metricCondition.comparisonType"\n          single-select="true"\n          searchable="false"\n          class="goals-wizard-details-dropdown"\n          disabled="::!ctrl.canEdit"></ga-select-dropdown>\n\n      <div class="goals-wizard-details-inline-block-item">\n        <input type="number"\n               name="numPagesScreens"\n               class="galaxy-input goals-wizard-details-number-input"\n               ng-model="ctrl.goal.pagesPerVisit.metricCondition.comparisonValue"\n               ga-zero-or-greater-required\n               ng-disabled="::!ctrl.canEdit"\n               aria-labelledby="num_pages_screens"/>\n      </div>\n    </div>\n    <ga-error-label targets="numPagesScreens">\n      <ga-error-label-msg catches="zeroOrGreaterRequiredDirective">\n        Please enter a number that is zero or greater.\n      </ga-error-label-msg>\n    </ga-error-label>\n  </div>\n\n  <ga-goal-value ng-model="ctrl.goal.pagesPerVisit.goalValue"\n                 is-on="ctrl.useNumPagesGoalValue"\n                 currency-display-name="{{ ctrl.wizardConfig.currencyDisplayName }}"\n                 disabled="::!ctrl.canEdit"></ga-goal-value>\n</div>\n'),
