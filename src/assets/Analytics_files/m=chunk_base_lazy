a.put("/analytics/app/activities/admin/integrations/dslinks/submitconsequences/ds-links-submit-consequences.html",'<div class="ds-links-submit-consequences">\n  <div class="consequences-description">\n    <span ng-if="!$ctrl.editMode"\n          class="create-description ga-wizard-step-header-title">\n      Creating this link enables auto-tagging for all linked Search Ads 360 accounts. \n    </span>\n    <span ng-if="$ctrl.editMode"\n          class="edit-description ga-wizard-step-header-title">\n      Saving this link enables auto-tagging for all linked Search Ads 360 accounts. \n    </span>\n    <br>\n    <span class="consequences-note">\n      Auto-tagging allows Analytics to automatically associate Search Ads 360 data with customer clicks. \n    </span>\n  </div>\n</div>\n'),
