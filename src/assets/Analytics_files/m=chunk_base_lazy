a.put("/analytics/app/activities/admin/integrations/allproducts/all-products.html",'<h1 class="title">\n  Google Analytics Product Linking\n</h1>\n\n<p>\n  Link Google Analytics to your other accounts to get the most out of your data.\n</p>\n\n<div class="linked-products" ng-if="ctrl.hasLinkedProducts">\n  <h2 class="subtitle">\n    Linked Products\n  </h2>\n  <ga-all-products-adsense\n      ng-if="ctrl.allProducts.adsenseLinked && !ctrl.isWave2UaDeprecationEnabled"\n      linked="true"\n      has-edit="ctrl.canEdit"></ga-all-products-adsense>\n  <ga-all-products-adwords\n      ng-if="ctrl.allProducts.adwordsLinked"\n      linked="true"\n      has-edit="ctrl.canEdit"></ga-all-products-adwords>\n  <ga-all-products-adx\n      ng-if="ctrl.allProducts.adxLinked && !ctrl.isWave2UaDeprecationEnabled"\n      linked="true"\n      has-edit="ctrl.canEdit"></ga-all-products-adx>\n  <ga-all-products-big-query\n      ng-if="ctrl.allProducts.bigQueryLinked &&\n        ctrl.isUaBigqueryLinkDeprecationBypassEnabled"\n      linked="true"\n      has-edit="ctrl.canEdit"\n      is-premium="ctrl.currentProperty.isPremium"></ga-all-products-big-query>\n  <ga-all-products-dbm\n      ng-if="ctrl.allProducts.doubleclickBidManagerLinkedSending || ctrl.allProducts.doubleclickBidManagerLinkedReceiving"\n      sends-data="ctrl.allProducts.doubleclickBidManagerLinkedSending"\n      receives-data="ctrl.allProducts.doubleclickBidManagerLinkedReceiving"></ga-all-products-dbm>\n  <ga-all-products-dcm\n      ng-if="ctrl.allProducts.doubleclickCampaignManagerLinked"\n      linked="true"\n      has-edit="ctrl.canEdit"\n      is-premium="ctrl.currentProperty.isPremium"></ga-all-products-dcm>\n  <ga-all-products-dc-search\n      ng-if="ctrl.allProducts.doubleclickSearchLinked"\n      linked="true"></ga-all-products-dc-search>\n  <ga-all-products-postbacks\n      ng-if="ctrl.allProducts.postbacksLinked"\n      linked="true"\n      has-edit="ctrl.canEdit"></ga-all-products-postbacks>\n  <ga-all-products-sfmc\n      ng-if="ctrl.currentProperty.isPremium && ctrl.allProducts.sfmcLinked"\n      linked="true"\n      has-edit="ctrl.canEdit"></ga-all-products-sfmc>\n  <ga-all-products-wmx\n      ng-if="ctrl.allProducts.webmasterToolsLinked"\n      linked="true"\n      has-edit="ctrl.canEdit"></ga-all-products-wmx>\n</div>\n\n<div class="unlinked-products" ng-if="ctrl.hasUnlinkedProducts">\n  <h2 class="subtitle">\n    Unlinked Products\n  </h2>\n  <ga-all-products-adsense\n      ng-if="ctrl.isUnlinked(ctrl.allProducts.adsenseLinked) && !ctrl.isWave2UaDeprecationEnabled"\n      linked="false"\n      has-edit="ctrl.canEdit"></ga-all-products-adsense>\n  <ga-all-products-adwords\n      ng-if="ctrl.isUnlinked(ctrl.allProducts.adwordsLinked)"\n      linked="false"\n      has-edit="ctrl.canEdit"></ga-all-products-adwords>\n  <ga-all-products-adx\n      ng-if="ctrl.isUnlinked(ctrl.allProducts.adxLinked) && !ctrl.isWave2UaDeprecationEnabled"\n      linked="false"\n      has-edit="ctrl.canEdit"></ga-all-products-adx>\n  <ga-all-products-big-query\n      ng-if="ctrl.isUnlinked(ctrl.allProducts.bigQueryLinked) &&\n        ctrl.isUaBigqueryLinkDeprecationBypassEnabled"\n      linked="false"\n      has-edit="ctrl.canEdit"\n      is-premium="ctrl.currentProperty.isPremium"></ga-all-products-big-query>\n  <ga-all-products-dbm\n      ng-if="ctrl.isDbmUnlinked"\n      sends-data="false"\n      receives-data="false"></ga-all-products-dbm>\n  <ga-all-products-dcm\n      ng-if="ctrl.isUnlinked(ctrl.allProducts.doubleclickCampaignManagerLinked)"\n      linked="false"\n      has-edit="ctrl.canEdit"\n      is-premium="ctrl.currentProperty.isPremium"></ga-all-products-dcm>\n  <ga-all-products-dc-search\n      ng-if="ctrl.isUnlinked(ctrl.allProducts.doubleclickSearchLinked)"\n      linked="false"></ga-all-products-dc-search>\n  <ga-all-products-google-play></ga-all-products-google-play>\n  <ga-all-products-postbacks\n      ng-if="ctrl.isUnlinked(ctrl.allProducts.postbacksLinked)"\n      linked="false"\n      has-edit="ctrl.canEdit"></ga-all-products-postbacks>\n  <ga-all-products-sfmc\n      ng-if="ctrl.currentProperty.isPremium && ctrl.isUnlinked(ctrl.allProducts.sfmcLinked)"\n      linked="false"\n      has-edit="ctrl.canEdit"></ga-all-products-sfmc>\n  <ga-all-products-wmx\n      ng-if="ctrl.isUnlinked(ctrl.allProducts.webmasterToolsLinked)"\n      linked="false"\n      has-edit="ctrl.canEdit"></ga-all-products-wmx>\n</div>\n\n<p class="allproducts-data-sharing-warning">\n  In addition to the Google product integrations listed here, there are other ways Google Analytics data can be shared outside your account. For example, Analytics users can take and share screenshots, <a answer-id="1038573" ga-learn-more="">export or email reports</a> , and use the <a ga-url-with-locale="" href="https://developers.google.com/analytics/devguides/" target="_blank">Analytics APIs</a> to send data to independent applications. Google Analytics does not track and is not responsible for these or similar types of data sharing. Google Analytics users can also <a ui-sref="app.admin.account.settings">choose to share</a> Google Analytics data with Google to improve other products and services.\n</p>\n'),
a.put("/analytics/app/activities/admin/integrations/allproducts/bigquery-section.html",['<div class="allproducts-icon-bigquery"></div>\n<div class="allproducts-container">\n  <h2 class="allproducts-title">\n    BigQuery\n  </h2>\n\n  <ga-all-products-linked-section ng-if="linked"\n                                  sends-data="true" receives-data="false">\n  </ga-all-products-linked-section>\n\n  <p class="allproducts-description">\n    Google BigQuery is a Google Developers tool that enables super-fast queries over large data sets. You can export session and hit data from a Google Analytics 360 account into Google BigQuery, so you can run queries over all of your Analytics data.\n  </p>\n\n  <span ng-if="isPremium">\n    <p  ng-if="linked" class="big-query-linked">\n      Learn more <a href="https://cloud.google.com/bigquery/what-is-bigquery" target="_blank"> about BigQuery </a> and check out our <a answer-id="4419694" ga-learn-more="">BigQuery Cookbook</a> for help getting started.\n    </p>\n\n    <p ng-if="!linked">\n      Learn more <a href="https://cloud.google.com/bigquery/what-is-bigquery" target="_blank"> about BigQuery </a> and how to <a answer-id="3416092" ga-learn-more="">link your Google Analytics and BigQuery accounts</a>.\n    </p>\n\n    <ga-all-products-edit-button\n       view-link="app.admin.integrations.bigquery.editor"\n       linked="linked"\n       has-edit="hasEdit"',
'       create-text="'+c("Link BigQuery")+'">','    </ga-all-products-edit-button>\n  </span>\n\n  <p ng-if="!isPremium" class="big-query-not-premium">\n    Learn more <a href="https://cloud.google.com/bigquery/what-is-bigquery" target="_blank"> about BigQuery </a>.\n    Currently this integration is only available for Google Analytics 360 Properties. <a href="http://www.google.com/analytics/premium/" target="_blank"> Learn more about Google Analytics 360</a>.\n  </p>\n</div>\n'].join("\n")),a.put("/analytics/app/activities/admin/integrations/allproducts/dbm-section.html",
'<div class="allproducts-icon-display-video"></div>\n<div class="allproducts-container">\n  <h2 class="allproducts-title">\n    Display &amp; Video 360\n  </h2>\n\n  <ga-all-products-linked-section ng-if="sendsData || receivesData"\n                                  sends-data="sendsData" receives-data="receivesData">\n  </ga-all-products-linked-section>\n\n  <p class="allproducts-description">\n    Display &amp; Video 360 is Google\'s cross-exchange real-time-bidding buying solution for large customers. The integration provides users with the ability to create remarketing audiences from within a Google Analytics 360 account and then share the audiences with a Display &amp; Video 360 account for targeting.\n  </p>\n\n  <p>\n    Learn more about the <a href="https://www.google.com/doubleclick/advertisers/solutions/demand-side-platform.html" target="_blank"> Display &amp; Video 360 </a> and contact your customer service rep to adjust your Display &amp; Video 360 and Analytics account link.\n  </p>\n</div>\n'),
a.put("/analytics/app/activities/admin/integrations/allproducts/dc-search-section.html",'<div class="allproducts-icon-search-ads"></div>\n<div class="allproducts-container">\n  <h2 class="allproducts-title">\n    Search Ads 360\n  </h2>\n\n  <ga-all-products-linked-section ng-if="linked"\n                                  sends-data="true" receives-data="true">\n  </ga-all-products-linked-section>\n\n  <p class="allproducts-description">\n    Search Ads 360 is a search management platform that helps agencies and marketers efficiently manage some of the largest marketing campaigns in the world across multiple engines and media channels. Integrating with your GA account allows you to see Analytics site engagement stats in Search Ads 360.\n  </p>\n\n  <p>\n    Learn more about the <a answer-id="1187512" ga-learn-more="" help-center="ds">Search Ads 360</a> and contact your customer service rep to adjust your Search Ads 360 and Analytics account link.\n  </p>\n</div>\n'),
a.put("/analytics/app/activities/admin/integrations/allproducts/dcm-section.html",['<div class="allproducts-icon-campaign-manager"></div>\n<div class="allproducts-container">\n  <h2 class="allproducts-title">\n    Campaign Manager 360\n  </h2>\n\n  <ga-all-products-linked-section\n      ng-if="linked"\n      sends-data="false"\n      receives-data="true">\n  </ga-all-products-linked-section>\n\n  <p class="allproducts-description">\n    Campaign Manager 360 is an ad management and ad serving solution that helps agencies and advertisers manage the entire scope of digital advertising programs. This integration allows Google Analytics 360 customers to view and analyze Campaign Manager 360 data in Analytics.\n  </p>\n\n  <p>\n    Learn more about the <a answer-id="2709362" ga-learn-more="" help-center="dcm">Campaign Manager 360</a> and contact your customer service rep to adjust your Campaign Manager 360 and Analytics account link.\n  </p>\n\n  <ga-all-products-edit-button\n      view-link="{{ ::linked ?\n          \'app.admin.integrations.dcm-links.table\' :\n          \'app.admin.integrations.dcm-links.create\' }}"\n      linked="::linked"\n      has-edit="::(hasEdit && isPremium)"',
