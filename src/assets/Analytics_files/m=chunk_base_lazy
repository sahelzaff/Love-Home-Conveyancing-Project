'      create-text="'+c("Link Salesforce Marketing Cloud")+'">',"  </ga-all-products-edit-button>\n</div>\n"].join("\n")),a.put("/analytics/app/activities/admin/integrations/allproducts/wmx-section.html",['<div class="allproducts-icon-wmx"></div>\n<div class="allproducts-container">\n  <h2 class="allproducts-title">\n    Search Console\n  </h2>\n\n  <ga-all-products-linked-section ng-if="linked"\n                                  sends-data="false" receives-data="true">\n  </ga-all-products-linked-section>\n\n  <p class="allproducts-description">\n    Search Console can help you understand how users find your site through Google search. Identify ways to attract more attention to your site and prioritize development efforts.\n  </p>\n\n  <p ng-if="linked">\n    Learn more about <a href="https://www.google.com/webmasters/" target="_blank"> Search Console </a>.\n  </p>\n\n  <p ng-if="!linked">\n    Learn more about <a href="https://www.google.com/webmasters/" target="_blank"> Search Console </a> and how to <a answer-id="1308621" ga-learn-more=""> link Google Analytics and Search Console. </a>\n  </p>\n\n  <ga-all-products-edit-button view-link="app.admin.integrations.wmx"\n                               linked="linked"\n                               has-edit="hasEdit"',
