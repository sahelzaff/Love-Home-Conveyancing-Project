a.put("/analytics/app/activities/admin/integrations/bigquery/editor/bigquery-editor.html",['<header class="title">\n  Configure BigQuery Link\n</header>\n\n<p>\n  Enter any applicable coupons in BigQuery prior to submitting this configuration request.\n  <a ga-learn-more answer-id=3416092></a>\n</p>\n\n<ga-wizard back-sref="app.admin.integrations.allproducts"\n           read-only="!ctrl.canEdit"\n           initially-completed="ctrl.bigQueryLink && ctrl.bigQueryLink.viewId"\n           on-save="ctrl.submit()">\n  <steps>\n    <ga-wizard-step id="big-query-project-step">\n      <step-title>\n        Select BigQuery project\n      </step-title>\n      <step-summary>\n        {{ctrl.bigQueryProjectInput}}\n      </step-summary>\n      <step-body>\n        <p ng-attr-id="gaBigQueryProjectId">\n          Please enter the ID or number of the BigQuery project where the data should be sent.\n        </p>\n        <input type="text"\n               name="bigQueryProjectInput"\n               ng-model="ctrl.bigQueryProjectInput"\n               ng-disabled="!ctrl.canEdit || ctrl.bigQueryLink"\n               ng-model-options="{debounce: 500}"\n               ng-attr-aria-labelledby="gaBigQueryProjectId"\n               ga-big-query-project-input\n               required\n               class="galaxy-input"/>\n        <ga-error-label targets="bigQueryProjectInput">\n          <ga-error-label-msg catches="linkable">\n            <span id="big-query-project-not-linkable">\n              Unable to verify BigQuery project. Please verify that the project exists and that you have access, and then try again.\n            </span>\n          </ga-error-label-msg>\n        </ga-error-label>\n      </step-body>\n    </ga-wizard-step>\n    <ga-wizard-step id="view-step">\n      <step-title>\n        Select Google Analytics view\n      </step-title>\n      <step-summary>\n        {{ctrl.view.name}}\n      </step-summary>\n      <step-body>\n        <p>\n          Which view would you like to link?\n        </p>\n        <ga-select-dropdown name="view"\n                            items="ctrl.views"\n                            ng-model="ctrl.viewId"\n                            disabled="!ctrl.canEdit || ctrl.bigQueryLink"\n                            single-select="true"\n                            required>\n        </ga-select-dropdown>\n        <p>\n          If this is the first time that you have linked this view, then data will be backfilled for the smaller of 13 months or 10 billion hits.\n        </p>\n      </step-body>\n    </ga-wizard-step>\n    <ga-wizard-step id="contacts-step">\n      <step-title>\n        Select contacts\n      </step-title>\n      <step-summary>\n        <ga-big-query-link-contact-summary title="\'Daily Export Contact\'"\n                                           contact="ctrl.dailyExportCompleteContact">\n        </ga-big-query-link-contact-summary>\n\n        <ga-big-query-link-contact-summary title="\'Failure Contact\'"\n                                           contact="ctrl.failureContact">\n        </ga-big-query-link-contact-summary>\n      </step-summary>\n      <step-body>\n        <p id="error-cannot-manage"\n           ng-if="!ctrl.canManage"\n           class="ga-error-label">\n          Only users who can manage permissions can select contacts other than themselves.\n        </p>\n\n        <p>\n          Please select a contact for daily export completion notifications.\n        </p>\n        <ga-select-dropdown name="dailyExportCompleteContact"\n                            items="ctrl.dailyExportCompleteContacts"\n                            ng-model="ctrl.dailyExportContactEmail"\n                            disabled="!ctrl.canEdit"\n                            single-select="true">\n        </ga-select-dropdown>\n\n        <p>\n          Please select a contact for failure notifications.\n        </p>\n        <ga-select-dropdown name="failureContact"\n                            items="ctrl.failureContacts"\n                            ng-model="ctrl.failureContactEmail"\n                            disabled="!ctrl.canEdit"\n                            single-select="true">\n        </ga-select-dropdown>\n      </step-body>\n    </ga-wizard-step>\n    <ga-wizard-step id="realtime-preferences">\n      <step-title>\n        Select current day streaming preferences\n      </step-title>\n      <step-summary>\n        <div ng-if="!ctrl.realtimeExport">\n          Data exported in batch multiple times a day.\n        </div>\n        <div ng-if="ctrl.realtimeExport">\n          Data exported continuously.\n        </div>\n      </step-summary>\n      <step-body>\n        <p>\n          Please select level of data freshness for export.\n          <a ga-learn-more answer-id=3416092></a>\n        </p>\n        <div class="realtime-property-radios">\n          <ga-radiobutton name="realtimeExport" value="false"\n                          ng-model="ctrl.realtimeExport"\n                          disabled="!ctrl.isRealtimeEligible">\n            Data exported in batch multiple times a day\n            <div class="big-query-realtime-desc">\n              Data is refreshed multiple times a day and contains Ads data. This option will take effect immediately - your data will be exported at the next available export interval.\n            </div>\n          </ga-radiobutton>\n          <ga-radiobutton name="realtimeExport" value="true"\n                          ng-model="ctrl.realtimeExport"\n                          disabled="!ctrl.isRealtimeEligible">\n            Data exported continuously\n            <div class="big-query-realtime-desc" ng-if="ctrl.isRealtimeEligible">\n              Data is refreshed every 10 to 15 minutes and does not contain Ads data. This option will take effect after the next date boundary (tomorrow) for this property.\n            </div>\n            <div class="big-query-realtime-desc" ng-if="!ctrl.isRealtimeEligible">\n              The View you have selected cannot support continuous export. Please select another View if you wish to enable continuous export.\n              <a ga-learn-more answer-id=7084038></a>\n            </div>\n          </ga-radiobutton>\n        </div>\n      </step-body>\n    </ga-wizard-step>\n    <ga-wizard-step id="confirm-step"',
'                    confirm-text="'+c("Submit")+'"','                    continue-disabled="ctrl.status == Status.SUCCESS">\n      <step-title>\n        Confirm request\n      </step-title>\n      <step-summary>\n        <ga-big-query-link-status status="ctrl.status"></ga-big-query-link-status>\n      </step-summary>\n      <step-body>\n        <p>\n          If you have questions, please contact your account representative.\n        </p>\n\n        <ga-checkbox name="hasReadConsentText"\n                     disabled="!ctrl.canEdit || ctrl.bigQueryLink"\n                     ng-model="ctrl.hasReadConsentText"\n                     required>\n          By checking this checkbox you hereby acknowledge that\n        </ga-checkbox>\n        <ol class="consent-list">\n          <li>\n            You have read and followed the <a answer-id="3416092" ga-learn-more="">BigQuery linking instructions</a>.\n          </li>\n          <li>\n            You have read and agree to the following <a answer-id="6330247" ga-learn-more="">additional terms for this integration</a>.\n          </li>\n        </ol>\n\n        <div ng-if="ctrl.status == Status.PENDING">\n          <p>\n            <div class="icon-flapper"></div>\n            Please wait while your project and view are linked.\n          </p>\n        </div>\n\n        <ga-big-query-link-status status="ctrl.status"></ga-big-query-link-status>\n      </step-body>\n    </ga-wizard-step>\n  </steps>\n  <whats-next>\n    <button id="delete-link-button" class="btn pull-right" ng-click="ctrl.deleteLink()">\n      Unlink\n    </button>\n  </whats-next>\n</ga-wizard>\n'].join("\n")),
