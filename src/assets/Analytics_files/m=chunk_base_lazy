data="data">\n          <span class="conversion-event-table-event-name">{{data.conversionName}}</span>\n          <mat-icon *ngIf="data.isOncePerSession && !(isKeyEventsRenameEnabled$ | async)"\n                    [matTooltip]="MSG_CONVERSION_EVENT_ONCE_PER_SESSION_TOOLTIP"\n                    [attr.aria-label]="MSG_CONVERSION_EVENT_ONCE_PER_SESSION_TOOLTIP"\n                    role="button"\n                    aria-hidden="false"\n                    tabindex="0"\n                    class="conversion-event-table-once-per-session">\n            web\n          </mat-icon>\n          <mat-icon *ngIf="data.isOncePerSession && (isKeyEventsRenameEnabled$ | async)"\n                    [matTooltip]="MSG_KEY_EVENT_ONCE_PER_SESSION_TOOLTIP"\n                    [attr.aria-label]="MSG_KEY_EVENT_ONCE_PER_SESSION_TOOLTIP"\n                    role="button"\n                    aria-hidden="false"\n                    tabindex="0"\n                    class="conversion-event-table-once-per-session">\n            web\n          </mat-icon>\n        </ng-template>\n        <ng-template templateId="eventCount" let-data="data">\n          <div class="event-count-template">\n            <div class="data">{{data.eventCount.formattedValue}}</div>\n            <div class="delta {{data.eventCount.delta.deltaClass}}">\n              <div *ngIf="!!data.eventCount.delta.deltaIcon">\n                <mat-icon [svgIcon]="data.eventCount.delta.deltaIcon"\n                          class="delta-icon">\n                </mat-icon>\n              </div>\n              <span>{{data.eventCount.delta.value}}</span>\n            </div>\n          </div>\n        </ng-template>\n        <ng-template templateId="conversionValue" let-data="data">\n          <div *ngIf="data.conversionValue.delta.deltaClass === \'infinite\' &&\n                      data.conversionValue.rawData === 0; else conversionValueDataBlock"\n               class="conversion-value-template">\n            \n            <div class="data">-</div>\n          </div>\n          <ng-template #conversionValueDataBlock>\n            <div class="conversion-value-template">\n              <div class="data">{{data.conversionValue.formattedValue}}</div>\n              <div class="delta {{data.conversionValue.delta.deltaClass}}">\n                <div *ngIf="!!data.conversionValue.delta.deltaIcon">\n                  <mat-icon [svgIcon]="data.conversionValue.delta.deltaIcon"\n                            class="delta-icon">\n                  </mat-icon>\n                </div>\n                <span>{{data.conversionValue.delta.value}}</span>\n              </div>\n            </div>\n          </ng-template>\n        </ng-template>\n        <ng-template templateId="markConversion" let-data="data">\n          <div class="conversion-toggle-container">\n            <mat-slide-toggle aria-label="Toggle conversion"\n                              i18n-aria-label="Label on switch that toggles conversion"\n                              [checked]="data.toggleData.value"\n                              [disabled]="data.toggleData.disabled"\n                              (click)="$event.stopPropagation()"\n                              (change)="conversionEventsToggleOnClick(data)">\n            </mat-slide-toggle>\n          </div>\n        </ng-template>\n        <ng-template templateId="rowMenu" let-data="data">\n          <ga-conversion-overflow-menu [conversionEventJson]="data.conversionEventJson"\n                                       (onUpdate)="updateTableData()"\n                                       (click)="$event.stopPropagation()">\n          </ga-conversion-overflow-menu>\n        </ng-template>\n        <ng-template templateId="headerWithTooltip" let-col="col">\n          <div>\n            {{ col.text }}\n            <ga-help-tooltip\n              *ngIf="(col && col.tooltipId)"\n              [tooltipId]="col.tooltipId"\n              [tooltipLearnMoreLinkAnswerId]="col.tooltipLearnMoreLinkAnswerId"\n              [tooltipLearnMoreLinkHelpCenter]="col.tooltipLearnMoreLinkHelpCenter"\n              [tooltipAriaLabel]="col.tooltipAriaLabel"\n            ></ga-help-tooltip>\n          </div>\n        </ng-template>\n        <div *ngIf="conversionEvents?.length === 0"\n             basic-table-empty-message\n             class="conversion-event-table-empty">\n          <div class="conversion-event-table-empty-image">\n            <img class="no-data-icon"\n                role="none"\n                [alt]=""\n                [ga-static-src]="\'static/mobile/ZeroStateIcons/zero-state-event.png\'" />\n          </div>\n          <div class="conversion-event-table-empty-info">\n            <div *ngIf="!(isKeyEventsRenameEnabled$ | async)"\n                 class="conversion-event-table-empty-title">\n              {{MSG_CONVERSION_EVENTS_NO_DATA_GOLD}}\n            </div>\n            <div *ngIf="isKeyEventsRenameEnabled$ | async"\n                 class="conversion-event-table-empty-title">\n              {{MSG_KEY_EVENTS_NO_DATA_GOLD}}\n            </div>\n            <div class="conversion-event-table-empty-learn-more">\n              <mat-icon aria-hidden="true"\n                        class="conversion-event-table-empty-learn-more-icon">\n                description\n              </mat-icon>\n              <a *ngIf="!(isKeyEventsRenameEnabled$ | async)"\n                 ga-learn-more\n                 helpCenter="firebase"\n                 answerId="6317518"\n                 target="_blank"\n                 i18n="Text of link to learn more about adding a network.">\n                Learn more about adding a conversion event\n              </a>\n              <a *ngIf="isKeyEventsRenameEnabled$ | async"\n                 ga-learn-more\n                 helpCenter="firebase"\n                 answerId="6317518"\n                 target="_blank"\n                 i18n="Text of link to learn more about adding a network.">\n                Learn more about adding a key event\n              </a>\n            </div>\n          </div>\n        </div>\n      </basic-table>\n    </div>\n  </xap-card>\n</div>\n'),
a.put("/analytics/app/activities/mobile/reports/attribution/network_settings_builder.ng.html",'<mdx-slider-header class="ga-network-settings-builder-header slider-header">\n  <div mdx-title-section class="slider-title">\n    <div mdx-slider-title class="ga-network-settings-builder-title">\n      <h1 *ngIf="customTitle && !!existingNetwork"\n          class="ga-network-settings-builder-title-text">\n        {{customTitle}}\n      </h1>\n      <h1 *ngIf="!existingNetwork"\n          class="ga-network-settings-builder-title-text"\n          i18n="Title text for a slider to add a network.">\n          Add a network\n      </h1>\n      <div class="ga-network-settings-builder-logo-header"\n          *ngIf="selectedAdNetwork">\n        <img [ga-static-src]="selectedAdNetwork.image"\n             [alt]="selectedAdNetwork.displayName">\n      </div>\n    </div>\n  </div>\n  <button mdx-action-button\n          mat-raised-button\n          (click)="submit()"\n          [disabled]="disableSave"\n          color="primary"\n          class="ga-network-settings-builder-save"\n          i18n="Text on button to create network.">\n    Save\n  </button>\n</mdx-slider-header>\n\n<div class="ga-network-settings-builder-body">\n  <xap-card class="container-card">\n    <div xapCardContent class="ga-network-settings-builder-card-content">\n      <div *ngIf="showErrorMessage"\n           class="ga-network-settings-builder-error-message"\n           i18n="Warning message that the user cannot proceed further because no app has been linked\n                yet.">\n        Error! Cannot add a network because no app has been linked yet. Please link to an app.\n      </div>\n      <div class="ga-network-settings-builder-app-inputs">\n        <mat-form-field appearance="outline">\n          <mat-label i18n="Title for the menu that lets the user select an ad network in the\n                           networks builder">\n            Campaign source\n          </mat-label>\n          <input matInput\n                 [formControl]="networkInputControl"\n                 [matAutocomplete]="gaNetworkSettingsBuilderNetworkSourceAuto"\n                 type="text"\n                 placeholder="Enter network name"\n                 i18n-placeholder="Placeholder text informing the user to enter a network name."\n                 class="ga-network-settings-builder-source-input" />\n          <mat-autocomplete #gaNetworkSettingsBuilderNetworkSourceAuto\n                            (optionSelected)="updateAdNetwork(\n                                              AD_NETWORK_MAP.get($event.option.value)!)">\n            <mat-option *ngFor="let item of selectableNetworks$ | async"\n                        [value]="item.key"\n                        class="ga-network-settings-builder-option">\n              {{item.displayName}}\n            </mat-option>\n          </mat-autocomplete>\n          <mat-error *ngIf="networkInputControl.hasError(\'required\')"\n                    i18n="Error message shown underneath the ad network input field when nothing has\n                          been selected."\n            >Please select a network\n          </mat-error>\n        </mat-form-field>\n\n        <mat-form-field appearance="outline">\n          <mat-label i18n="Title for app selector dropdown">\n            Select an app\n          </mat-label>\n          <mat-icon *ngIf="streamIcon"\n                    [svgIcon]="streamIcon"\n                    matPrefix\n                    aria-hidden="true"\n                    class="ga-network-settings-builder-stream-icon"\n                    [class.ga-network-settings-builder-stream-icon-disabled]="streamInputControl.disabled">\n          </mat-icon>\n          <input matInput\n                 [formControl]="streamInputControl"\n                 [matAutocomplete]="gaNetworkSettingsBuilderStreamSourceAuto"\n                 type="text"\n                 placeholder="Select a stream"\n                 i18n-placeholder="Placeholder text informing the user to enter a stream."\n                 class="ga-network-settings-builder-stream-input" />\n          <mat-autocomplete #gaNetworkSettingsBuilderStreamSourceAuto\n                            (optionSelected)="switchStream($event.option.value)">\n            <mat-option *ngFor="let item of selectableStreams$ | async"\n                        [value]="item.value"\n                        [disabled]="item.disabled">\n              <mat-icon *ngIf="item.icon"\n                        [svgIcon]="item.icon"\n                        aria-hidden="true">\n              </mat-icon>\n              <span>{{item.display}}</span>\n            </mat-option>\n          </mat-autocomplete>\n        </mat-form-field>\n      </div>\n      <div class="ga-network-settings-builder-campaign-inputs">\n        <mat-form-field *ngIf="!!selectedAdNetwork && !selectedAdNetwork?.campaignMedium"\n                        appearance="outline">\n          <mat-label i18n="Title for the campaign medium input field.">\n            Campaign medium\n          </mat-label>\n          <input matInput\n                [formControl]="campaignMediumControl"\n                placeholder="Enter campaign medium (optional)"\n                i18n-placeholder="Placeholder text for the optional campaign medium field."\n                class="ga-network-settings-builder-campaign-medium" />\n        </mat-form-field>\n\n        <mat-form-field  *ngIf="!!selectedAdNetwork && !selectedAdNetwork?.campaignName"\n                         appearance="outline">\n          <mat-label i18n="Title for the campaign name input field.">\n            Campaign name\n          </mat-label>\n          <input matInput\n                [formControl]="campaignNameControl"\n                placeholder="Enter campaign name (optional)"\n                i18n-placeholder="Placeholder text for the optional campaign name field."\n                class="ga-network-settings-builder-campaign-name" />\n        </mat-form-field>\n      </div>\n      <div *ngIf="!!selectedAdNetwork">\n        <ng-template #gaNetworkSettingsBuilderCampaignUrlHeader>\n          <div class="ga-network-settings-builder-url-label">\n            <span i18n="Generated campaign URL for downloads."\n                  class="caption">\n              Generated campaign URL\n            </span>\n            <ga-help-tooltip [tooltipId]="6390982"\n                             [tooltipAriaLabel]="MSG_GENERATED_CAMPAIGN_URL_TOOLTIP_ARIA_LABEL"\n                             class="ga-network-settings-builder-url-tooltip">\n            </ga-help-tooltip>\n          </div>\n        </ng-template>\n        <div i18n="The text above two tabs that allow the user to generate a url for download or\n                   deeplinking."\n             class="ga-network-settings-builder-url-header subtitle">\n          Run campaign for\n        </div>\n        <mat-tab-group mat-stretch-tabs="false"\n                       mat-align-tabs="start"\n                       class="ga-network-settings-builder-url-tabs">\n          <mat-tab label="Click"\n                   i18n-label="The label for a tab that allows the user to generate campaign\n                               urls for app downloads.">\n            <ng-container *ngTemplateOutlet="gaNetworkSettingsBuilderCampaignUrlHeader">\n            </ng-container>\n            <div class="ga-network-settings-builder-url-click">\n              <ga-admin-copy-button [content]="(clickCampaignUrl$ | async) ?? \'\'">\n              </ga-admin-copy-button>\n              <span>{{clickCampaignUrl$ | async}}</span>\n            </div>\n          </mat-tab>\n          <mat-tab label="Deep Link"\n                   i18n-label="The label for a tab that allows the user to generate campaign urls\n                               for deep linking into apps.">\n            <div class="ga-network-settings-builder-deep-link-url-inputs">\n              <mat-form-field appearance="outline">\n                <mat-label>\n                  <span i18n="Title for the URL scheme input field for generating deep link urls."\n                        class="ga-network-settings-builder-url-scheme-title">\n                    URL Scheme\n                  </span>\n                  <ga-help-tooltip [tooltipId]="6390944"\n                                    [tooltipAriaLabel]="MSG_DEEP_LINK_CAMPAIGN_URL_SCHEME_TOOLTIP_ARIA_LABEL">\n                  </ga-help-tooltip>\n                </mat-label>\n                <input matInput\n                      [formControl]="urlSchemeControl"\n                      placeholder="Enter URL scheme"\n                      i18n-placeholder="Placeholder text for the input field for URL scheme for\n                                        deep link url generation."\n                      class="ga-network-settings-builder-url-scheme"\n                      [attr.aria-label]="MSG_DEEP_LINK_CAMPAIGN_URL_SCHEME_INPUT_ARIA_LABEL" />\n                <mat-error *ngIf="urlSchemeControl.hasError(\'required\') && !!selectedAdNetwork"\n                            i18n="Error message shown under the URL scheme input field when a\n                                  network has been selected but the field is empty. This field\n                                  is mandatory to generate a deep link URL."\n                  >Please enter a URL scheme.\n                </mat-error>\n              </mat-form-field>\n              <div class="ga-network-settings-builder-deep-link-input-separator">\n                \n                ://\n              </div>\n              <mat-form-field appearance="outline">\n                <mat-label>\n                  <span i18n="Title for the (optional) path input field for generating deep link\n                              urls."\n                        class="ga-network-settings-builder-url-path-title">\n                    Path\n                  </span>\n                  <ga-help-tooltip [tooltipId]="6390979"\n                                    [tooltipAriaLabel]="MSG_DEEP_LINK_CAMPAIGN_URL_PATH_TOOLTIP_ARIA_LABEL">\n                  </ga-help-tooltip>\n                </mat-label>\n                <input matInput\n                      [formControl]="urlPathControl"\n                      placeholder="Enter path (optional)"\n                      i18n-placeholder="Placeholder text for the optional input field for path for\n                                        deep link url generation."\n                      class="ga-network-settings-builder-url-path"\n                      [attr.aria-label]="MSG_DEEP_LINK_CAMPAIGN_URL_PATH_INPUT_ARIA_LABEL" />\n              </mat-form-field>\n            </div>\n            <ng-container *ngTemplateOutlet="gaNetworkSettingsBuilderCampaignUrlHeader">\n            </ng-container>\n            <div *ngIf="urlSchemeControl.value"\n                 class="ga-network-settings-builder-url-deep-link">\n              <ga-admin-copy-button [content]="(deepLinkCampaignUrl$ | async) ?? \'\'">\n              </ga-admin-copy-button>\n              <span>{{deepLinkCampaignUrl$ | async}}</span>\n            </div>\n          </mat-tab>\n          <mat-tab *ngIf="showImpressionsTab"\n                   label="Impression"\n                   i18n-label="The label for a tab that allows the user to generate campaign\n                               urls for impressions.">\n            <ng-container *ngTemplateOutlet="gaNetworkSettingsBuilderCampaignUrlHeader">\n            </ng-container>\n            <div class="ga-network-settings-builder-url-impression">\n              <ga-admin-copy-button [content]="(impressionCampaignUrl$ | async) ?? \'\'">\n              </ga-admin-copy-button>\n              <span>{{impressionCampaignUrl$ | async}}</span>\n            </div>\n          </mat-tab>\n        </mat-tab-group>\n      </div>\n      <div *ngIf="!!selectedAdNetwork"\n            class="ga-network-settings-builder-postback">\n        <mat-slide-toggle [formControl]="configurePostbackControl"\n                          (change)="updateDisableSave()"\n                          i18n="Text for a slide toggle to enable configuration of postbacks."\n                          class="ga-network-settings-builder-postback-toggle">\n          Configure Postback\n        </mat-slide-toggle>\n        <div>\n          <ng-container *ngIf="!existingNetwork && configurePostbackControl.pristine"\n                        i18n="Text informing the user that they have not configured postbacks.">\n            You have not configured postbacks yet.\n          </ng-container>\n          <span *ngIf="!(isKeyEventsRenameEnabled$ | async)"\n                i18n="Text explaining how postbacks work.">\n            Postbacks allow you to send conversion data back to the networks on which you advertise.\n          </span>\n          <span *ngIf="isKeyEventsRenameEnabled$ | async"\n                i18n="Text explaining how postbacks work.">\n            Postbacks allow you to send key event data back to the networks on which you advertise.\n          </span>\n          <a ga-learn-more\n              helpCenter="firebase"\n              answerId="6317518"\n              hash="#postbacks"\n              target="_blank"\n              i18n="A link to learn more on configuring postbacks.">\n            Learn more about postbacks\n          </a>\n        </div>\n        <ng-container *ngIf="configurePostbackControl.value">\n          <div class="ga-network-settings-builder-postback-conversion-type">\n            <span *ngIf="!(isKeyEventsRenameEnabled$ | async)"\n                   i18n="The text before the conversion types selection menu. It is in the postback\n                        configuration section of the networks builder and is part of the full string\n                        \'Send the conversions {selected conversions types} attributed to\n                        {only this network or all networks} to this network.\' The text in braces is\n                        selected using dropdowns.">\n              Send the conversions\n            </span>\n            <span *ngIf="(isKeyEventsRenameEnabled$ | async)"\n                   i18n="The text before the key event types selection menu. It is in the postback\n                        configuration section of the networks builder and is part of the full string\n                        \'Send the key events {selected key event types} attributed to\n                        {only this network or all networks} to this network.\' The text in braces is\n                        selected using dropdowns.">\n              Send the key events\n            </span>\n            <searchable-select [formControl]="selectedConversionsControl"\n                               [multiple]="true"\n                               [placeholder]="MSG_CONVERSION_EVENT_NAME_SEARCH_PLACEHOLDER"\n                               [styleAsMatFormField]="true"\n                               [showError]="!!(showSelectedConversionsControlError$ | async)"\n                               class="ga-network-settings-builder-postback-conversion-type-select">\n              <ng-template value-label let-value>\n                <mat-label class="ga-network-settings-builder-postback-conversion-type-select-label"\n                  >{{selectedConvTypeDisplayText}}\n                </mat-label>\n              </ng-template>\n              <ng-container *ngFor="let item of selectableConversionTypes">\n                <div *searchableSelectOption="item">{{item.name}}</div>\n              </ng-container>\n              <div searchable-select-error>\n                <span *ngIf="!!selectedConversionsControl.errors?.[\'required\'] && !(isKeyEventsRenameEnabled$ | async)"\n                       i18n="Error message shown under the conversion types dropdown when no\n                             conversion types have been selected."\n                  >Please select at least one conversion type\n                </span>\n                <span *ngIf="!!selectedConversionsControl.errors?.[\'required\'] && (isKeyEventsRenameEnabled$ | async)"\n                       i18n="Error message shown under the key event types dropdown when no\n                             key event types have been selected."\n                  >Please select at least one key event type\n                </span>\n                <span *ngIf="!!selectedConversionsControl.errors?.[\'maxlength\'] && !(isKeyEventsRenameEnabled$ | async)"\n                  >{{SELECTED_CONVERSION_TYPES_LIMIT_ERROR_TEXT}}\n                </span>\n                <span *ngIf="!!selectedConversionsControl.errors?.[\'maxlength\'] && (isKeyEventsRenameEnabled$ | async)"\n                  >{{SELECTED_KEY_EVENT_TYPES_LIMIT_ERROR_TEXT}}\n                </span>\n              </div>\n            </searchable-select>\n            <span i18n="The text before a selection menu that allows the user to choose\n                        whether the current network will receive conversions attributed to all\n                        networks or only those attributed to itself. It is in the postback\n                        configuration section of the networks builder. It is part of the full\n                        string \'Send the conversions {selected conversions types} attributed to\n                        {only this network or all networks} to this network.\' The text in braces is\n                        selected using dropdowns.">\n              attributed to\n            </span>\n            <mat-form-field appearance="outline"\n                            class="ga-network-settings-builder-postback-conversion-type-send">\n              <mat-select [formControl]="sendOptionControl"\n                          class="ga-network-settings-builder-postback-conversion-type-send-select">\n                <mat-option [value]="SEND_POSTBACK_OPTIONS[0]">\n                  {{SEND_POSTBACK_OPTIONS[0]}}\n                </mat-option>\n                <mat-option [value]="SEND_POSTBACK_OPTIONS[1]"\n                            [disabled]="selectedAdNetwork.cannotReceiveFromAll">\n                  {{SEND_POSTBACK_OPTIONS[1]}}\n                </mat-option>\n              </mat-select>\n            </mat-form-field>\n            <span i18n="The text after a selection menu that allows the user to choose\n                        whether the current network will receive conversions  attributed to all\n                        networks or only those attributed to itself. It refers to the currently\n                        selected network. It is in the postback configuration section of the\n                        networks builder. It is part of the full string \'Send the conversions\n                        {selected conversions types} attributed to {only this network or all\n                        networks} to this network.\' The text in braces is selected using\n                        dropdowns.">\n              to this network.\n            </span>\n          </div>\n\n          <ng-container *ngIf="selectedAdNetwork.appNetworkParams">\n            <div class="ga-network-settings-builder-postback-app-params-title subtitle">\n              {{appNetworkParamsTitle}}\n            </div>\n            <mat-form-field appearance="outline"\n                            *ngFor="let networkParam of appNetworkParams; index as i"\n                            class="ga-network-settings-builder-app-param-field">\n              <mat-label>{{networkParam.name}}</mat-label>\n              <input matInput\n                     [formControl]="networkParamsForms[i]"\n                     (keyup)="updateNetworkParam($event, networkParam)"\n                     placeholder="Enter tracking ID"\n                     i18n-placeholder="Placeholder text for app level network parameter fields for\n                                       configuring postbacks."\n                     aria-label="Enter app level network parameter"\n                     i18n-aria-label="Input field for app level network parameters for postback\n                                      configuration."\n                     class="ga-network-settings-builder-postback-app-param-input" />\n              <mat-error *ngIf="networkParamsForms[i].errors"\n                          i18n="Error message shown underneath the app level network parameter input\n                                field when nothing has been input."\n                >Please enter a network parameter\n              </mat-error>\n            </mat-form-field>\n          </ng-container>\n\n          <ng-container *ngIf="selectedAdNetwork.conversionNetworkParams &&\n                               convTypesForNetworkParams.length > 0">\n            <div i18n="Title text for the section that allows users to enter network parameter for\n                       each conversion type that has been selected. This is part of the postback\n                       configuration in the networks builder."\n                 class="ga-network-settings-builder-postback-conversion-params-title subtitle">\n              Enter network parameters for each conversion\n            </div>\n            <div *ngFor="let convType of convTypesForNetworkParams index as i"\n                 class="ga-network-settings-builder-postback-conversion-param-group">\n              <div class="ga-network-settings-builder-postback-conversion-param-name">\n                {{convType.name}}\n              </div>\n              <mat-form-field appearance="outline"\n                              *ngFor="let networkParam of convType.networkParams; index as j"\n                              class="ga-network-settings-builder-postback-conversion-param">\n                <mat-label>{{networkParam.name}}</mat-label>\n                <input matInput\n                       [formControl]="conversionNetworkParamsForms[i][j]"\n                       (keyup)="updateNetworkParam($event, networkParam)"\n    