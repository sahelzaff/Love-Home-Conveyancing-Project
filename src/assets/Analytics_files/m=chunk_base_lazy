a.put("/analytics/app/activities/admin/integrations/dbmlinksv2/complete/dbmlinks-complete.html",['<header class="title">\n  Configure the link between Google Analytics and Display &amp; Video 360\n</header>\n<p class="W_FORMS_ITEM_DESCRIPTION">\n  By linking your Analytics property to your Display &amp; Video 360 (DV360) account(s), you will enable data to flow between the products. Data exported from your Analytics property into DV360 is subject to  DV360 terms of service, while DV360 data imported into Analytics is subject to the Analytics terms of service. \n  <a ga-learn-more answer-id="6318719"></a>\n</p>\n\n<div class="ga-wizard-step" aria-hidden="false">\n  <div class="ga-wizard-step-header editable" aria-role="tab" aria-label="edit step 1"\n       aria-disabled="!ctrl.isCurrentStep() &amp;&amp; !ctrl.showSummary"\n       aria-selected="ctrl.isCurrentStep()" ng-click="ctrl.onHeaderEdit()"\n       ng-enter="ctrl.onHeaderEdit()" tabindex="0" role="button">\n    <div class="ga-wizard-step-number summary">&nbsp;</div>\n    <div>\n      <div class="ga-wizard-step-header-title">\n        Advertiser ID: {{ctrl.authorizationRequest.advertiserId}}\n      </div>\n    </div>\n    <div class="ga-wizard-step-summary">\n      {{ctrl.authorizationRequest.advertiserName || \'Advertiser name\'}}\n    </div>\n  </div>\n</div>\n\n<ga-wizard back-sref="app.admin.integrations.dbm-linksv2.table"\n           ng-class="{\'dbmlinks-hide-cancel\': true}"\n           on-save="ctrl.save()"\n           read-only="!ctrl.canEdit"\n           initially-completed="false">\n  <steps>\n    <ga-wizard-step',
