a.put("/analytics/app/activities/admin/integrations/dbmlinksv2/table/dbmlinks-table.html",'<header class="title">\n  DV360 Linking\n</header>\n\n<ga-table\n    name="dbmTable"\n    search-enabled="true"\n    sort-enabled="true"\n    sort-function="ctrl.compareRows"\n    default-sort-column-id="name"\n    blacklisted-search-keys="[\'views\', \'linkUid\']">\n  <div controls-template>\n    <button type="button" class="ga-table-action-button create-button"\n            ng-disabled="{{!ctrl.canCreateDbmLinks()}}"\n            ui-sref="app.admin.integrations.dbm-linksv2.create()">\n      + New DV360 Link\n    </button>\n  </div>\n  <table>\n    <tr header-template>\n      <th ga-sortable-header-cell sort-key="name" class="dbmlinks-table-row-title">\n        Link title\n      </th>\n      <th ga-sortable-header-cell sort-key="advertiserId">\n        Advertiser Id\n      </th>\n      <th ga-sortable-header-cell sort-key="partnerId">\n        Partner Id\n      </th>\n      <th ga-sortable-header-cell sort-key="linkedViews">\n        Linked views\n      </th>\n    </tr>\n    <tr row-template>\n      <td>\n        <a ui-sref="app.admin.integrations.dbm-linksv2.edit({ linkUid: rowData.linkUid })"\n           ng-bind="::ctrl.renderName(rowData)"></a>\n      </td>\n      <td ng-bind="::rowData.advertiserId"></td>\n      <td ng-bind="::rowData.partnerId"></td>\n      <td>\n        <ga-account-tree-picker\n                type="view"\n                exclude-trashed="true"\n                single-select="false"\n                ng-model="rowData.views"\n                on-close="ctrl.onClose(rowData)"\n                disabled="!ctrl.canEdit"\n                data-link-uid="{{ rowData.linkUid }}"></ga-account-tree-picker>\n      </td>\n    </tr>\n  </table>\n</ga-table>\n\n<div ng-if="ctrl.nonDualAdminEnabled && ctrl.requestRows.length > 0">\n  <h4 class="dbm-requests-header">Pending requests</h4>\n\n  <ga-table\n          name="dbmAuthorizationsTable"\n          search-enabled="true"\n          sort-enabled="true"\n          sort-function="ctrl.compareRequestRows"\n          default-sort-column-id="requestDate"\n          sort-descending="true"\n          blacklisted-search-keys="[\'authorizationUid\']">\n    <table>\n      <tr header-template>\n        <th ga-sortable-header-cell sort-key="requestDate"\n            class="dbm-requests-table-row-date">\n          Request date\n        </th>\n        <th ga-sortable-header-cell sort-key="advertiserId"\n            class="dbm-requests-table-row-advertiser-id">\n          Advertiser Id\n        </th>\n        <th ga-sortable-header-cell sort-key="advertiserName"\n            class="dbm-requests-table-row-advertiser">\n          Advertiser Name\n        </th>\n        <th ga-sortable-header-cell sort-key="status"\n            class="dbm-requests-table-row-status">\n          Link Status\n        </th>\n        <th ga-sortable-header-cell sort-key="approverComment"\n            class="dbm-requests-table-row-comment">\n          Comment\n        </th>\n        <th class="dbm-requests-table-row-actions">\n          Actions\n        </th>\n      </tr>\n      <tr row-template>\n        <td>{{ rowData.requestDate | date : \'mediumDate\' }}</td>\n        <td ng-bind="::rowData.advertiserId"></td>\n        <td ng-bind="::rowData.advertiserName"></td>\n        <td>\n          <span ng-if="::rowData.status == ctrl.StatusType.UNKNOWN">\n            Unknown\n          </span>\n\n          <span ng-if="::rowData.status == ctrl.StatusType.PROPOSED">\n            Pending Approval\n          </span>\n\n          <span ng-if="::rowData.status == ctrl.StatusType.APPROVED">\n            Approved\n          </span>\n\n          <span ng-if="::rowData.status == ctrl.StatusType.REJECTED">\n            Rejected\n          </span>\n\n          <span ng-if="::rowData.status == ctrl.StatusType.WITHDRAWN">\n            Withdrawn\n          </span>\n        </td>\n        <td ng-bind="::rowData.approverComment"></td>\n        <td class="dbm-requests-table-row-actions-buttons">\n          <button type="button" class="btn"\n                  ng-if="ctrl.canDeleteAuthorizationRequest(rowData)"\n                  ng-click="ctrl.deleteAuthorizationRequestDialog(rowData)">\n            Withdraw\n          </button>\n          <button type="button" class="btn"\n                  ng-if="ctrl.canCopyAuthorizationRequestLink(rowData)"\n                  ng-click="ctrl.displayAuthorizationRequestDialogLink(rowData)">\n            Copy Link\n          </button>\n          <button type="button" class="btn share"\n                  ng-if="ctrl.canCompleteAuthorizationRequest(rowData)"\n                  ui-sref="app.admin.integrations.dbm-linksv2.complete({ authorizationUid: rowData.authorizationUid })">\n            Complete link\n          </button>\n        </td>\n      </tr>\n    </table>\n  </ga-table>\n</div>\n'),
