a.put("/analytics/app/activities/admin/integrations/dcmlinks/create/dcm-links-create.html",['<div class="dcm-links-create">\n  <header class="title">\n    Create Link(s) with Campaign Manager 360 \n  </header>\n  <p>\n    By linking your Analytics property to your Campaign Manager 360 (CM360) account(s), you will enable data to flow between the products. Data exported from your Analytics property may be used in CM360 per the CM360 terms of service, while CM360 data imported into Analytics is subject to the Analytics terms of service. \n    <a ga-learn-more answer-id="{{::ctrl.helpTopic.DCM_SELF_SERVE_LINKING}}"></a>\n  </p>\n  <ga-wizard back-sref="app.admin.integrations.dcm-links.table"\n             ng-class="{\'hide-cancel\': !ctrl.canEdit}"\n             on-save="ctrl.save()"\n             read-only="!ctrl.canEdit"\n             initially-completed="false">\n    <steps>\n      <ga-wizard-step\n          continue-disabled="ctrl.firstStepContinueDisabled()">\n        <step-title>\n          Campaign Manager 360 Advertiser(s)\n        </step-title>\n        <step-summary>\n          <div>{{ ctrl.getStepOneSummaryMsg() }}</div>\n        </step-summary>\n        <step-body>\n          <form>\n\n            <div class="no-permissions" ng-if="!ctrl.canEdit">\n              You don\'t have permissions required to link a Campaign Manager 360 advertiser account. \n              <br>\n              Please verify that you have Partner level access in Campaign Manager 360. \n              <a ga-learn-more answer-id="{{::ctrl.helpTopic.DCM_SELF_SERVE_LINKING}}"></a>\n            </div>\n\n            <div class="ga-form-item">\n              <div class="content">\n\n                \n                <div ng-if="::ctrl.canEdit">\n\n                  \n                  <div class="dual-admin">\n                    <ga-radiobutton value="ctrl.setupType.DUAL_ADMIN"\n                                    disabled="!ctrl.hasLinkableAdvertisers()"\n                                    ng-model="ctrl.activeSetupType"\n                                    ng-click="ctrl.resetTwoAdminsAdvertisers()"\n                                    name="dcmSetupType"\n                                    inline="true">\n                      <strong>\n                        Linkable advertiser(s) \n                      </strong>\n                      <ga-help-tooltip-ng1\n                          topic-id="{{::ctrl.helpTopic.SELF_SERVE_LINKABLE_ADVERTISERS}}"></ga-help-tooltip-ng1>\n                      <p>\n                        Link CM360 advertisers using their Floodlight Configuration IDs. \n                      </p>\n                      <div class="dual-admin-dropdown">\n                        <ga-select-dropdown\n                            items="ctrl.linkableAdvertisersItems"\n                            name="advertisersPicker"\n                            disabled="ctrl.activeSetupType != ctrl.setupType.DUAL_ADMIN"\n                            ng-required="ctrl.activeSetupType == ctrl.setupType.DUAL_ADMIN"\n                            ng-model="ctrl.dualAdminAdvertisers"\n                            ng-model-options="{allowInvalid: true}"\n                            auto-focus="true"\n                            searchable="true"\n                            single-select="false"',
'                            empty-text="'+c("Please select advertiser(s)")+'"','                            button-label="'+c("Please select advertiser(s)")+'"></ga-select-dropdown>','                        <ga-error-label targets="advertisersPicker"></ga-error-label>\n                        <div class="multiple-advertisers-selected"\n                             ng-if="ctrl.dualAdminAdvertisers.length > 1">\n                          A new link will be created for every selected advertiser. \n                        </div>\n                      </div>\n                    </ga-radiobutton>\n                  </div>\n                  \n\n                  \n                  <div class="two-admins">\n                    <ga-radiobutton value="ctrl.setupType.TWO_ADMINS"\n                                    ng-model="ctrl.activeSetupType"\n                                    ng-click="ctrl.resetDualAdminAdvertisers()"\n                                    name="dcmSetupType"\n                                    inline="false">\n                      <strong>\n                        Other advertiser(s)\n                      </strong>\n                    </ga-radiobutton>\n\n                    <div class="advertisers-inputs">\n                      <p>\n                        Request to link Campaign Manager 360 Advertiser account you do not have administrative access to. A request will be sent for approval to the Campaign Manager 360 account owner. By initiating this account-linking request, you agree to share your email and/or name with the administrator of the Campaign Manager 360 account. \n                      </p>\n\n                      <div class="advertisers-entry"\n                           ng-repeat="entry in ctrl.twoAdminsAdvertisers track by $index">\n\n                        <div>\n                          <input name="floodlightId{{$index}}"\n                                 type="number"\n                                 ng-model="entry.floodlightId"\n                                 ng-required="$index == 0 || $index < ctrl.twoAdminsAdvertisers.length - 1"\n                                 pattern="\\d{1,19}"\n                                 maxlength="19"',
'                                 placeholder="'+c("Enter CM360 Floodlight config Id")+'"','                                 class="galaxy-input">\n                          <input name="advertiserEmail{{$index}}"\n                                 type="email"\n                                 ng-model="entry.approverEmail"\n                                 ng-model-options="{ debounce: 100 }"\n                                 ng-required="$index == 0 || $index < ctrl.twoAdminsAdvertisers.length - 1"\n                                 ga-validate-email="[PREEXISTING_USER, EXTERNAL_USER]"',
'                                 placeholder="'+c("Enter CM360 Advertiser email")+'"','                                 class="galaxy-input">\n                          <span class="advertisers-remove"\n                                ng-if="ctrl.twoAdminsAdvertisers.length > 1"\n                                ng-click="ctrl.removeTwoAdminsAdvertiser($index)"></span>\n                        </div>\n                        <div>\n                          <div class="ga-error-label active-authorization"\n                              targets="floodlightId{{$index}}"\n                              ng-if="entry.floodlightId && !ctrl.isAvailableTwoAdminsAdvertiser(entry.floodlightId)">\n                            An authorization request already exists for this advertiser. \n                          </div>\n                          <div class="ga-error-label already-linked"\n                              targets="floodlightId{{$index}}"\n                              ng-if="ctrl.isLinkedAdvertiser(entry.floodlightId)">\n                            A link already exists between the property and this Campaign Manager 360 advertiser. \n                          </div>\n                          <div class="ga-error-label direct-advertiser"\n                              targets="floodlightId{{$index}}"\n                              ng-if="ctrl.isLinkableAdvertiser(entry.floodlightId)">\n                            A linkable advertiser must be linked directly. \n                          </div>\n                          <ga-error-label targets="advertiserEmail{{$index}}">\n                            <ga-error-label-msg catches="unknownEmail">\n                              No Google account exists for this email. \n                            </ga-error-label-msg>\n                            <ga-error-label-msg catches="nonUser">\n                              The specified account is not a valid user account. It is an entity or resource. \n                            </ga-error-label-msg>\n                            <ga-error-label-msg catches="userMigration">\n                              The specified account is being migrated. You may use this account instead: {{validationAlternateEmail}}\n                            </ga-error-label-msg>\n                          </ga-error-label>\n                        </div>\n\n                      </div>\n\n                      <button class="advertisers-add btn"\n                              ng-if="ctrl.activeSetupType == ctrl.setupType.TWO_ADMINS"\n                              ng-click="ctrl.addTwoAdminsAdvertiser()"',
'                              aria-label="'+c("Add Campaign Manager 360 Advertiser to contact")+'">','                        Add\n                      </button>\n\n                    </div>\n                  </div>\n                  \n\n                </div>\n                \n\n              </div>\n            </div>\n          </form>\n        </step-body>\n      </ga-wizard-step>\n\n      <ga-wizard-step\n          name="finalStep"\n          confirm-text="{{ ctrl.getFinalStepButtonTitle() }}"\n          continue-disabled="!(finalStep.$valid && ctrl.importReportingData)">\n        <step-title>\n          Link configuration \n        </step-title>\n        <step-summary>\n          <div>\n            <strong class="step2-title">\n              {{ ctrl.getStepTwoSummaryTitleMsg() }}.\n            </strong>\n            {{ ctrl.getStepTwoSummaryMsg() }}\n          </div>\n        </step-summary>\n        <step-body>\n          <form>\n\n            \n            <ga-dcm-links-title\n                ng-if="ctrl.activeSetupType == ctrl.setupType.DUAL_ADMIN"\n                link-title="ctrl.selectedName">\n            </ga-dcm-links-title>\n\n            \n            <div class="ga-form-item"\n                 ng-if="ctrl.activeSetupType == ctrl.setupType.DUAL_ADMIN">\n              <div class="desc">\n                <strong>\n                  Linked view(s) \n                </strong>\n                <ga-help-tooltip-ng1\n                    topic-id="{{::ctrl.helpTopic.SELF_SERVE_LINKED_VIEWS}}"></ga-help-tooltip-ng1>\n              </div>\n              <div class="content">\n                <ga-account-tree-picker\n                    name="viewPicker"\n                    type="view"\n                    exclude-trashed="true"\n                    single-select="false"\n                    ng-model="ctrl.selectedViews"\n                    ng-model-options="{allowInvalid: true}">\n                </ga-account-tree-picker>\n              </div>\n              <ga-error-label targets="viewPicker"></ga-error-label>\n            </div>\n\n            \n            <div class="ga-form-item">\n              <div class="content">\n                <ga-dcm-links-submit-consequences\n                    ng-if="ctrl.activeSetupType == ctrl.setupType.DUAL_ADMIN">\n                </ga-dcm-links-submit-consequences>\n                <div class="two-admins-request-info"\n                     ng-if="ctrl.activeSetupType == ctrl.setupType.TWO_ADMINS">\n                  Request the ability to... \n                </div>\n              </div>\n            </div>\n\n            \n            <div class="ga-form-item">\n              <div class="content">\n                <ga-dcm-links-advanced-settings\n                    display-zippy="ctrl.activeSetupType == ctrl.setupType.DUAL_ADMIN"\n                    reporting-enabled="ctrl.importReportingData"\n                    cost-enabled="ctrl.importCostData"\n                    is-readonly="ctrl.isImportingCheckboxDisabled()">\n                </ga-dcm-links-advanced-settings>\n              </div>\n            </div>\n\n          </form>\n        </step-body>\n      </ga-wizard-step>\n    </steps>\n  </ga-wizard>\n</div>\n'].join("\n")),
a.put("/analytics/app/activities/admin/integrations/dcmlinks/edit/dcm-links-delete-dialog.html",'<section class="ga-dialog-title">\n  Are you sure you want to delete this link? \n</section>\n<section class="ga-dialog-content owned-by-user">\n  Unlinking this CM360 floodlight configuration from Analytics will stop all data flowing between the CM360 and Analytics properties: \n  <ul>\n    <li>\n      CM360 data won\'t be visible in Analytics reports. CM360 data up until the time you unlink the property will still be available. \n    </li>\n  </ul>\n</section>\n<section class="ga-dialog-buttons">\n  <ga-button-delete ng-click="$confirm()"></ga-button-delete>\n  <ga-button-cancel ng-click="$cancel()"></ga-button-cancel>\n</section>\n'),
a.put("/analytics/app/activities/admin/integrations/dcmlinks/edit/dcm-links-delete.html",'<a class="delete-link" ng-if="ctrl.canEdit" ng-click="ctrl.deleteLink()">\n  Delete link\n</a>\n'),a.put("/analytics/app/activities/admin/integrations/dcmlinks/edit/dcm-links-edit.html",['<div class="dcm-links-edit">\n  <header class="title">\n    Configure the link between Google Analytics and Campaign Manager 360\n  </header>\n  <p class="W_FORMS_ITEM_DESCRIPTION">\n    By linking your Analytics property to your Campaign Manager 360 (CM360) account(s), you will enable data to flow between the products. Data exported from your Analytics property may be used in CM360 per the CM360 terms of service, while CM360 data imported into Analytics is subject to the Analytics terms of service. \n    <a ga-learn-more answer-id="{{::ctrl.helpTopic.DCM_SELF_SERVE_LINKING}}"></a>\n  </p>\n\n  <div class="ga-wizard-step">\n    <div class="ga-wizard-step-header editable"\n         tabindex="0"\n         role="button">\n      <div class="ga-wizard-step-number summary">&nbsp;</div>\n      <div>\n        <div class="ga-wizard-step-header-title">\n          Advertiser ID: {{ctrl.link.floodlightConfigurationId}} \n        </div>\n      </div>\n      <div class="ga-wizard-step-summary">\n        {{ctrl.selectedAdvertiserName || \'&nbsp;\'}}\n      </div>\n    </div>\n  </div>\n\n  <ga-wizard back-sref="app.admin.integrations.dcm-links.table"\n             on-save="ctrl.save()"\n             read-only="!ctrl.canEdit"\n             initially-completed="true">\n    <steps>\n      <ga-wizard-step\n          name="finalStep"',
'          confirm-text="'+c("Update link")+'"','          continue-disabled="!(finalStep.$valid && ctrl.importReportingData)">\n        <step-title>\n          Link configuration \n        </step-title>\n        <step-summary>\n          <div>\n            <strong class="step2-title">\n              {{ ctrl.getStepTwoSummaryTitleMsg() }}.\n            </strong>\n            {{ ctrl.getStepTwoSummaryMsg() }}\n          </div>\n        </step-summary>\n        <step-body>\n          <form>\n\n            \n            <ga-dcm-links-title\n                link-title="ctrl.link.name"\n                disabled="!ctrl.canEdit">\n            </ga-dcm-links-title>\n\n            \n            <div class="ga-form-item">\n              <div class="desc">\n                <strong>\n                  Linked view(s) \n                </strong>\n                <ga-help-tooltip-ng1\n                    topic-id="{{::ctrl.helpTopic.SELF_SERVE_LINKED_VIEWS}}"></ga-help-tooltip-ng1>\n              </div>\n              <div class="content">\n                <ga-account-tree-picker\n                    name="viewPicker"\n                    type="view"\n                    exclude-trashed="true"\n                    single-select="false"\n                    disabled="!ctrl.canEdit"\n                    ng-model="ctrl.link.views"></ga-account-tree-picker>\n              </div>\n              <ga-error-label targets="viewPicker"></ga-error-label>\n            </div>\n\n            \n            <div class="ga-form-item">\n              <div class="content">\n                <ga-dcm-links-submit-consequences\n                    edit-mode="true">\n                </ga-dcm-links-submit-consequences>\n              </div>\n            </div>\n\n            \n            <div class="ga-form-item">\n              <div class="content">\n                <ga-dcm-links-advanced-settings\n                    reporting-enabled="ctrl.importReportingData"\n                    cost-enabled="ctrl.importCostData"\n                    is-readonly="ctrl.isImportingCheckboxDisabled()">\n                </ga-dcm-links-advanced-settings>\n              </div>\n            </div>\n          </form>\n        </step-body>\n      </ga-wizard-step>\n    </steps>\n    <extra-global-buttons>\n      <div ng-include="\'/analytics/app/activities/admin/integrations/dcmlinks/edit/dcm-links-delete.html\'"></div>\n    </extra-global-buttons>\n    <whats-next>\n      <div ng-include="\'/analytics/app/activities/admin/integrations/dcmlinks/edit/dcm-links-delete.html\'"></div>\n    </whats-next>\n  </ga-wizard>\n</div>\n'].join("\n")),
a.put("/analytics/app/activities/admin/integrations/dcmlinks/features/dcm-links-allowed-features.html",'<div class="dcm-links-allowed-features">\n  <ga-checkbox ng-model="$ctrl.reportingEnabled"\n               ng-change="$ctrl.onReportingEnabledChange()"\n               disabled="::$ctrl.disabled">\n    <strong>\n      Import Campaign Manager 360 Campaign Data\n    </strong>\n    <ga-help-tooltip-ng1\n        topic-id="{{::$ctrl.helpTopic.SELF_SERVE_IMPORT_DBM_REPORTING_DATA}}"></ga-help-tooltip-ng1>\n  </ga-checkbox>\n  <div class="note">\n    This allows the Analytics user to view campaign data (excluding cost data) from the Campaign Manager 360 advertiser in Analytics. \n  </div>\n  <div class="cost-enabled"\n       ng-if="$ctrl.reportingEnabled">\n    <ga-checkbox\n        ng-model="$ctrl.costEnabled"\n        disabled="::$ctrl.disabled">\n      <strong>\n        Import Campaign Manager 360 Cost Data\n      </strong>\n      <ga-help-tooltip-ng1\n          topic-id="{{::$ctrl.helpTopic.SELF_SERVE_IMPORT_DBM_COST_DATA}}"></ga-help-tooltip-ng1>\n    </ga-checkbox>\n    <div class="cost-enabled-note">\n      This allows the Analytics user to view cost data from the Campaign Manager 360 advertiser. The cost data we import is the same value as media cost in Campaign Manager 360 based on schedule and pricing information that was entered for each placement. \n      <a ga-learn-more\n         answer-id="{{::$ctrl.helpTopic.DCM_SELF_SERVE_LINKING}}"></a>\n    </div>\n  </div>\n</div>\n'),
a.put("/analytics/app/activities/admin/integrations/dcmlinks/submitconsequences/dcm-links-submit-consequences.html",'<div class="dcm-links-submit-consequences">\n  <div class="consequences-description">\n    <span ng-if="!$ctrl.editMode"\n          class="create-description ga-wizard-step-header-title">\n      Creating this link enables auto-tagging for all linked Campaign Manager 360 accounts. \n    </span>\n    <span ng-if="$ctrl.editMode"\n          class="edit-description ga-wizard-step-header-title">\n      Saving this link enables auto-tagging for all linked Campaign Manager 360 accounts. \n    </span>\n    <br>\n    <span class="consequences-note">\n      Auto-tagging allows Analytics to automatically associate Campaign Manager 360 data with customer clicks \n    </span><br><br>\n    <span class="ga-wizard-step-header-title">\n      Enable Advertising Features \n    </span><br>\n    <span class="consequences-note">\n      <a answer-id="{{::ctrl.helpTopic.ENABLE_REMARKETING}}" ga-learn-more="">Advertising Features</a> should also be enabled for this integration to work. Please note that <a answer-id="{{::ctrl.helpTopic.ADVERTISING_POLICY_REQUIREMENTS}}" ga-learn-more=""> updates to your privacy policy</a> might be required. \n      <a ga-learn-more answer-id="{{::ctrl.helpTopic.DCM_SELF_SERVE_LINKING}}"></a>\n    </span>\n  </div>\n</div>\n'),
a.put("/analytics/app/activities/admin/integrations/dcmlinks/table/dcm-authorization-delete-dialog.html",'<section class="ga-dialog-title">\n  Are you sure you want to delete this authorization request to CM360 advertiser? \n</section>\n<section class="ga-dialog-content owned-by-user">\n  Floodlight Configuration ID: {{floodlightId}} \n</section>\n<section class="ga-dialog-buttons">\n  <ga-button-delete ng-click="$confirm()"></ga-button-delete>\n  <ga-button-cancel ng-click="$cancel()"></ga-button-cancel>\n</section>\n'),
a.put("/analytics/app/activities/admin/integrations/dcmlinks/table/dcm-copy-authorization-link-dialog.html",'<header class="ga-dialog-title">\n  <span ng-if="requestSent">\n    {{::dialogTitle}}\n  </span>\n  <span ng-if="!requestSent">\n    Copy Campaign Manager 360 authorization link\n  </span>\n</header>\n\n<section class="ga-dialog-content">\n  <p ng-if="requestSent">\n    {{::dialogSentMessage}}\n  </p>\n  <p ng-if="!requestSent">\n    {{::dialogExpiredMessage}}\n  </p>\n  <ul class="dcm-copy-request-link-item">\n    <li ng-repeat="link in authorizationLinks track by $index">\n      <a href="{{link}}" target="_blank">{{link}}</a>\n    </li>\n  </ul>\n  <p ng-if="failedLinks.length > 0">\n    Creation of the following link(s) has failed:\n  </p>\n  <ul>\n    <li ng-repeat="failedLink in failedLinks track by $index">\n      {{failedLink.floodlightId}} / {{emailMap[failedLink.floodlightId]}}\n      <p ng-if="failedLink.error.message">{{failedLink.error.message}}</p>\n      <p ng-if="failedLink.error.code == errorCode.DCM_ERROR_DUPLICATE">\n        Request with this advertiser already exists.\n      </p>\n    </li>\n  </ul>\n</section>\n\n<section class="ga-dialog-buttons">\n  <ga-button-ok ng-click="$confirm()"></ga-button-ok>\n</section>\n'),
a.put("/analytics/app/activities/admin/integrations/dcmlinks/table/dcm-links-table.html",'<header class="title">\n  Campaign Manager 360 \n</header>\n\n<ga-table\n    rows="ctrl.linkRows"\n    search-enabled="true"\n    sort-enabled="true"\n    sort-function="ctrl.compareLinks"\n    default-sort-column-id="name"\n    blacklisted-search-keys="[\'views\', \'dfaLinkUid\']">\n  <div controls-template>\n    <button type="button" class="ga-table-action-button create-button"\n            ng-disabled="{{!ctrl.canCreateLink()}}"\n            ui-sref="app.admin.integrations.dcm-links.create">\n      + New CM360 Link \n    </button>\n  </div>\n  <table>\n    <tr header-template>\n      <th ga-sortable-header-cell sort-key="name" class="dcm-links-table-row-title">\n        Link title\n      </th>\n      <th ga-sortable-header-cell sort-key="floodlightConfigurationId">\n        Floodlight config Id\n      </th>\n      <th ga-sortable-header-cell sort-key="networkId">\n        CM360 account Id\n      </th>\n      <th ga-sortable-header-cell sort-key="views">\n        Linked views\n      </th>\n    </tr>\n    <tr row-template>\n      <td>\n        <a ui-sref="app.admin.integrations.dcm-links.edit({ linkUid: rowData.dfaLinkUid })"\n           ng-bind="::ctrl.renderName(rowData)"></a>\n      </td>\n      <td ng-bind="::rowData.floodlightConfigurationId"></td>\n      <td ng-bind="::rowData.networkId"></td>\n      <td>\n        <ga-account-tree-picker\n            type="view"\n            exclude-trashed="true"\n            single-select="false"\n            ng-model="rowData.views"\n            on-close="ctrl.onAccountPickerClose(rowData)"\n            disabled="!ctrl.canEdit"\n            data-link-uid="{{ rowData.dfaLinkUid }}"></ga-account-tree-picker>\n      </td>\n    </tr>\n  </table>\n</ga-table>\n\n<div ng-if="ctrl.requestRows.length > 0">\n  <h4 class="dcm-requests-header">\n    Pending requests\n  </h4>\n\n  <ga-table\n      rows="ctrl.requestRows"\n      search-enabled="true"\n      sort-enabled="true"\n      sort-function="ctrl.compareRequests"\n      default-sort-column-id="requestDate"\n      sort-descending="true"\n      blacklisted-search-keys="[\'authorizationUid\']">\n    <table>\n      <tr header-template>\n        <th ga-sortable-header-cell sort-key="requestDate"\n            class="dcm-requests-table-row-date">\n          Request date\n        </th>\n        <th ga-sortable-header-cell sort-key="floodlightId"\n            class="dcm-requests-table-row-floodlight-id">\n          Floodlight config Id\n        </th>\n        <th ga-sortable-header-cell sort-key="advertiserName"\n            class="dcm-requests-table-row-advertiser">\n          Advertiser Name\n        </th>\n        <th ga-sortable-header-cell sort-key="status"\n            class="dcm-requests-table-row-status">\n          Link Status\n        </th>\n        <th ga-sortable-header-cell sort-key="approverComment"\n            class="dcm-requests-table-row-comment">\n          Comment\n        </th>\n        <th class="dcm-requests-table-row-actions">\n          Actions\n        </th>\n      </tr>\n      <tr row-template>\n        <td>{{ rowData.requestDate | date : \'mediumDate\' }}</td>\n        <td ng-bind="::rowData.floodlightId"></td>\n        <td ng-bind="::rowData.advertiserName"></td>\n        <td class="dcm-requests-table-row-status-data">\n          <span ng-if="::rowData.status == ctrl.STATUS_TYPE.UNKNOWN">\n            Unknown\n          </span>\n          <span ng-if="::rowData.status == ctrl.STATUS_TYPE.PROPOSED">\n            Pending Approval\n          </span>\n          <span ng-if="::rowData.status == ctrl.STATUS_TYPE.APPROVED">\n            Approved\n          </span>\n          <span ng-if="::rowData.status == ctrl.STATUS_TYPE.REJECTED">\n            Rejected\n          </span>\n          <span ng-if="::rowData.status == ctrl.STATUS_TYPE.WITHDRAWN">\n            Withdrawn\n          </span>\n        </td>\n        <td ng-bind="::rowData.approverComment"></td>\n        <td class="dcm-requests-table-row-actions-data">\n          <button type="button" class="btn dcm-request-button-delete"\n                  ng-if="ctrl.canDeleteRequest(rowData)"\n                  ng-click="ctrl.deleteRequestDialog(rowData)">\n            Withdraw\n          </button>\n          <button type="button" class="btn dcm-request-button-copy"\n                  ng-if="ctrl.canCopyRequestLink(rowData)"\n                  ng-click="ctrl.displayCopyRequestLinkDialog(rowData)">\n            Copy Link\n          </button>\n          <button type="button" class="btn share dcm-request-button-complete"\n                  ng-if="ctrl.canCompleteRequest(rowData)"\n                  ui-sref="app.admin.integrations.dcm-links.complete({\n                    authorizationUid: rowData.authorizationUid\n                  })">\n            Complete link\n          </button>\n        </td>\n      </tr>\n    </table>\n  </ga-table>\n</div>\n'),
a.put("/analytics/app/activities/admin/integrations/dcmlinks/title/dcm-links-title.html",'<div class="dcm-links-title">\n  <div class="ga-form-item">\n    <div class="desc" id="dcm_link_title">\n      <strong>\n        Link title\n      </strong>\n      <ga-help-tooltip-ng1 topic-id="{{::ctrl.helpTopic.SELF_SERVE_LINK_TITLE}}"></ga-help-tooltip-ng1>\n    </div>\n    <div class="content">\n      <input type="text"\n             name="title"\n             ng-model="$ctrl.linkTitle"\n             aria-labelledby="dcm_link_title"\n             ng-disabled="$ctrl.disabled"\n             class="galaxy-input"\n             required />\n    </div>\n    <ga-error-label targets="title"></ga-error-label>\n  </div>\n</div>\n'),
a.put("/analytics/app/activities/admin/integrations/dfplinks/table/dfp-links-table.html",'<header class="title">Google Ad Manager</header>\n<form name="dfpLinksTableForm" novalidate>\n  <div class="description">\n    <p>\n      Use this screen to select which of your Google Analytics views should show data from your linked Google Ad Manager networks. Clicking a checkbox in a Google Ad Manager network column will enable that network\'s data to appear in the view associated with the row in which the checkbox is located.\n    </p>\n    <p>\n      The "Hide GAM Revenue" checkboxes can be used to prevent a Google Analytics view from showing Google Ad Manager and Google Ad Manager Backfill based revenue metrics. When enabled, these revenue metrics will either be hidden or will return zeroes as a value. Calculated metrics based off of Google Ad Manager revenue metrics will use zero in their formulas in lieu of your actual Google Ad Manager revenue.\n    </p>\n  </div>\n  <ga-table\n    rows="ctrl.rows"\n    search-enabled="true"\n    sort-enabled="true"\n    sort-function="ctrl.sortFunction"\n    default-sort-column-id="viewName">\n    <table>\n      <tr header-template>\n        <th ga-sortable-header-cell sort-key="viewName">\n          View\n        </th>\n        <th ga-sortable-header-cell sort-descending="true"  sort-key="hideDfpRevenue">\n          Hide GAM Revenue\n        </th>\n        <th ng-repeat="dfpLink in ctrl.dfpLinks"\n            sort-descending="true"\n            ga-sortable-header-cell\n            sort-key="dfpNetwork{{$index}}">\n          GAM Network\n          {{dfpLink.networkCode}}\n        </th>\n      </tr>\n      <tr row-template>\n        <td ng-bind="rowData.view.name"></td>\n        <td>\n          <ga-checkbox ng-model="rowData.hideDfpRevenue" disabled="::!ctrl.canEdit">\n          </ga-checkbox>\n        </td>\n        <td ng-repeat="dfpNetwork in rowData.dfpNetworks">\n          <ga-checkbox ng-model="dfpNetwork.checked" disabled="::!ctrl.canEdit">\n          </ga-checkbox>\n        </td>\n      </tr>\n    </table>\n  </ga-table>\n  <ga-submit-buttons no-submit-button="::!ctrl.canEdit"\n      disabled-submit-button="!dfpLinksTableForm.$dirty"\n      submit="ctrl.save()"\n      monitor-submit-action="DfpLinkEditorSubmit"\n      cancel-ui-sref="app.admin.integrations.dfp-links.table">\n  </ga-submit-buttons>\n</form>\n'),
