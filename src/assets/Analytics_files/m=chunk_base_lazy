a.put("/analytics/app/activities/admin/integrations/allproducts/gtm-section.html",'<div class="allproducts-icon-optimize-gtm"></div>\n<div class="allproducts-container">\n  <h2 class="allproducts-title">\n    Google Optimize and Tag Manager for website and app optimization\n  </h2>\n\n  <ga-all-products-linked-section ng-if="linked"\n                                  sends-data="false" receives-data="true">\n  </ga-all-products-linked-section>\n\n  <p class="allproducts-description">\n    Google Optimize lets you test and personalize your website using your Google Analytics data for measurement and targeting.\n  </p>\n\n  <p class="allproducts-description">\n    With a Google Tag Manager integration, you can run tests on your mobile apps powered by Google Analytics Content Experiments.\n  </p>\n\n  <p>\n    Learn more about <a href="https://www.google.com/analytics/360-suite/optimize/" target="_blank">Google Optimize</a>, <a href="https://support.google.com/tagmanager/answer/6003007" target="_blank">mobile experiments with Google Tag Manager</a>, and <a answer-id="1745147" ga-learn-more="">Content Experiments in Google Analytics</a>.\n  </p>\n</div>\n'),
a.put("/analytics/app/activities/admin/integrations/allproducts/linked-section.html",'<p>\n  <span class="allproducts-icon-linked"></span>\n  <span ng-if="sendsData && receivesData">\n    Actively linked. Sending and receiving data.\n  </span>\n  <span ng-if="sendsData && !receivesData">\n    Actively linked. Sending data.\n  </span>\n  <span ng-if="!sendsData && receivesData">\n    Actively linked. Receiving data.\n  </span>\n</p>\n'),a.put("/analytics/app/activities/admin/integrations/allproducts/postbacks-section.html",
