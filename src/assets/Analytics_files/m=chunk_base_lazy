a.put("/analytics/app/common/services/gdpr/gdpr-dialog.html",'<form novalidate>\n  <div class="gdpr-pop-up-container ga-form-item">\n    <header class="gdpr-bold title">\n      User and event data retention\n    </header>\n    <p>\n      You are receiving this notification because you have not yet reviewed and saved your Data Retention setting. This setting enables you to control the retention period for data you send that is associated with user identifiers, including cookies and advertising ids. We advise that you do so as soon as possible and we have included the settings here for your ease of use. \n      These controls do not affect most standard reporting, which is based on aggregated data. (<a answer-id="7667196" ga-learn-more="">Learn more</a>) \n    </p>\n    <div class="content">\n      <label class="data-retention-control-label">\n        User and event data retention:\n        <ga-help-tooltip-ng1 topic-id="7678587"></ga-help-tooltip-ng1>\n      </label>\n      <ga-data-retention-selector duration="ctrl.getDataRetentionTtlDuration()"\n                                  on-duration-change="ctrl.onTtlDurationChange(value)"\n      >\n      </ga-data-retention-selector>\n    </div>\n    <p class="gdpr-bold gdpr-note">\n      Note: <span> The selector above shows your current setting, which will take effect on May 25, 2018 </span>\n    </p>\n    <ga-submit-buttons\n        save-text="Save"\n        cancel-text="Remind me later"\n        submit="ctrl.save()"\n        monitor-submit-action="DataRetentionSubmit"\n        compact="true"\n        cancel="ctrl.cancel()"\n    ></ga-submit-buttons>\n  </div>\n</form>\n<p>You can edit these settings at any time in Admin (<a ng-click="ctrl.cancel()" ui-sref="app.admin.trackinginfo.dataretention"> View Settings </a>) </p>\n'),
