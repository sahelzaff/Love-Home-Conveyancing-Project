\n\n  <section ng-if="ctrl.showQuota" class="ga-form-item view-quota-summary">\n    <div class="label">\n      {{ ctrl.quotaSummary }}\n    </div>\n  </section>\n\n  <section>\n    <ga-submit-buttons\n      submit="ctrl.submit()"\n      disabled-submit-button="ctrl.atQuota"',
