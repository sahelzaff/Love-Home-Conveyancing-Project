a.put("/analytics/app/activities/admin/integrations/wmx/wmx.html",'<form name="form" novalidate>\n  <h1 class="title">\n    Search Console Settings\n  </h1>\n\n  <div class="ga-form-item">\n    <div class="label">\n      Search Console site\n      <ga-help-tooltip-ng1 topic-id="3134690"></ga-help-tooltip-ng1>\n    </div>\n    <div class="desc">\n      By linking your Analytics property to your Search Console property, you will enable data to flow between the products. Data exported from your Search Console property into Google Analytics is subject to the Google Analytics terms of service, while Google Analytics data imported into Search Console is subject to the Search Console of service. By creating this link, your email address will be recorded and may be visible to authorized users of this Google Analytics property and/or the linked Search Console property. \n      <a ga-learn-more answer-id="1308621">Learn more</a>\n    </div>\n    <div class="content">\n\n      <span ng-if="ctrl.wmxDataJson.linkUrl">\n        {{ ctrl.wmxDataJson.linkUrl }}\n      </span>\n      <span ng-if="!ctrl.wmxDataJson.linkUrl">\n        none\n      </span>\n\n      <span ng-if="ctrl.canEdit">\n        <span ng-if="ctrl.wmxDataJson.linkUrl">\n          <a ga-wmx-edit-link class="new-window">\n            Delete\n          </a>\n        </span>\n        <span ng-if="!ctrl.wmxDataJson.linkUrl">\n          <a ga-wmx-edit-link class="new-window">\n            Add\n          </a>\n        </span>\n      </span>\n\n    </div>\n  </div>\n  <div class="ga-form-item" ng-if="ctrl.wmxDataJson.linkUrl">\n    <div class="label">\n      Enabled views\n    </div>\n    <div class="content">\n      <ga-account-tree-picker type="view"\n                              ng-model="ctrl.wmxDataJson.selectedViews"\n                              disabled="!ctrl.canEdit"></ga-account-tree-picker>\n    </div>\n  </div>\n\n  <ga-submit-buttons no-submit-button="!ctrl.canEdit || !ctrl.wmxDataJson.linkUrl"\n                     cancel-ui-sref="app.admin.property.settings"\n                     submit="ctrl.submit()"></ga-submit-buttons>\n</form>\n'),
a.put("/analytics/app/activities/admin/phone/editor/phone-editor.html",'<header class="title">Phone Analytics</header>\n\n<form class="phone-form">\n\n  <div class="error-message-container" ng-if="ctrl.errorCode !== ctrl.errorCodeEnum.OK">\n    <md-icon>error_outline</md-icon>\n    <div class="error-message">\n      <span ng-if="ctrl.errorCode === ctrl.errorCodeEnum.ALREADY_EXISTS"\n            class="already-exists-error-message">\n        The destination number {{ctrl.currentLink.destinationNumber}} is already associated with a phone conversion. Please enter a different destination number.\n      </span>\n      <span ng-if="ctrl.errorCode !== ctrl.errorCodeEnum.ALREADY_EXISTS"\n            class="unknown-error-message">\n        Something went wrong, please try again later.\n      </span>\n    </div>\n  </div>\n\n  <p>\n  Change how conversions are tracked for this phone number.\n  </p>\n\n  <div class="ga-form-item">\n    <div class="label">\n      Destination Number Label\n    </div>\n    <div class="content">\n      <input type="text" ng-model="ctrl.currentLink.label" class="galaxy-input">\n    </div>\n    <p class="detail-text">\n    For example, "Main Line", "Customer Support", or "Sales"\n    </p>\n  </div>\n  <div class="ga-form-item">\n    <div class="label">\n      Destination Number\n    </div>\n    <div class="content">\n      <input type="text"\n             name="number"\n             ga-phone-number\n             ng-model="ctrl.currentLink.destinationNumber"\n             class="galaxy-input">\n    </div>\n    <p class="detail-text">\n      The phone number that calls are forwarded to, including area code. For example, (555) 555-5555\n    </p>\n    <ga-error-label targets="number">\n      <ga-error-label-msg catches="validPhoneNumber">\n        Please enter a valid phone number.\n      </ga-error-label-msg>\n    </ga-error-label>\n  </div>\n  <div class="ga-form-item">\n    <div class="label">\n      Conversion Threshold (in seconds)\n    </div>\n    <div class="content">\n      <input type="text" ng-model="ctrl.currentLink.conversionThresholdSec" class="galaxy-input">\n    </div>\n    <p class="detail-text">\n      Calls longer than this will be counted as conversions.\n    </p>\n  </div>\n  <div class="ga-form-item">\n    <div class="label">\n      Conversion Value\n    </div>\n    <div class="content">\n      <span>\n        <input ga-phone-conversion-value\n               type="text"\n               name="conversionValue"\n               ng-model="ctrl.currentLink.conversionValue"\n               class="galaxy-input">\n        <span ng-bind="::ctrl.CURRENCY"></span>\n      </span>\n    </div>\n    <ga-error-label targets="conversionValue">\n      <ga-error-label-msg catches="invalidConversionValue">\n        Conversion value has to be an integer.\n      </ga-error-label-msg>\n    </ga-error-label>\n  </div>\n  <ga-submit-buttons\n    disabled-submit-button="!ctrl.canEdit"\n    submit="ctrl.save()"\n    cancel-ui-sref="app.admin.phone.table"></ga-submit-buttons>\n</form>\n'),
a.put("/analytics/app/activities/admin/phone/table/phone-table.html",'<header class="title">Phone Analytics</header>\n\n<ga-table\n    name="phoneTable"\n    search-enabled="true"\n    sort-enabled="true"\n    blacklisted-search-keys="[\'objectUid\']">\n  <div controls-template>\n    <button type="button" class="ga-table-action-button create-button"\n        ui-sref="app.admin.phone.editor({ objectUid: \'new\' })"\n        ng-disabled="{{!ctrl.canEdit}}">\n      + New Destination Number\n    </button>\n  </div>\n  <table>\n    <tr header-template>\n      <th ga-sortable-header-cell sort-key="label">\n        Label\n      </th>\n      <th ga-sortable-header-cell sort-key="destinationNumber">\n        Destination Number\n      </th>\n      <th ga-sortable-header-cell sort-key="conversionThresholdSec">\n        Conversion Threshold (in seconds)\n      </th>\n      <th ga-sortable-header-cell sort-key="conversionValue">\n        Conversion Value\n      </th>\n      <th class="admin-phone-table-delete-cell" ng-if="ctrl.canEdit"></th>\n    </tr>\n    <tr row-template>\n      <th>\n        <a class="ga-table-edit-link" ng-bind="::rowData.label" href="#"\n            ui-sref="app.admin.phone.editor({ objectUid: rowData.objectUid })">\n        </a>\n      </th>\n      <td ng-bind="::rowData.destinationNumber | usPhoneNumber"></td>\n      <td ng-bind="::rowData.conversionThresholdSec"></td>\n      <td ng-bind="::rowData.conversionValue | currency:\'$\':0"></td>\n      <td class="admin-phone-table-delete-cell" ng-if="ctrl.canEdit">\n        <a class="ga-table-link" href="#"\n           ng-click="ctrl.delete(rowData.objectUid)"></a>\n      </td>\n    </tr>\n  </table>\n</ga-table>\n'),
a.put("/analytics/app/activities/admin/piidatadeletion/create/piidatadeletion_create_button_component.html",'<div matTooltip="You have exceeded the active request limit of 250 requests. You can wait for\n                 these to complete before requesting another deletion, or you can cancel any of\n                 the existing active requests and enter a new one."\n     i18n-matTooltip="Tooltip next to disabled create button explaining restrictions."\n     [matTooltipDisabled]="!createDisabled"\n     matTooltipPosition="left">\n  <button class="btn action create-ddr-button"\n        (click)="openCreateDDRSlider()"\n        [disabled]="createDisabled"\n        i18n="Button label to open data deletion request form.">\n  Create Data Deletion Request\n  </button>\n</div>\n'),
a.put("/analytics/app/activities/admin/piidatadeletion/edit/piidatadeletion-edit.html",'<form name="editForm" novalidate class="piidatadeletion-editor" ng-if="::!$ctrl.newPiiDeletionEnabled">\n  <header class="title">\n    Data Deletion Request review\n  </header>\n\n  <section>\n    <header class="subtitle">\n      Data Deletion Request details\n    </header>\n    <div class="details-row tracking-id">\n      <span class="details-label">\n        Tracking ID:\n      </span>\n      {{::$ctrl.trackingId}}\n    </div>\n    <div class="details-row request-id">\n      <span class="details-label">Incident ID:</span>\n      {{::$ctrl.request.requestId}}\n    </div>\n    <div class="details-row notification-date">\n      <span class="details-label">\n        Notification date:\n      </span>\n      {{ ::$ctrl.request.notificationDate | fromISONumber | date : \'mediumDate\' }}\n    </div>\n    <div class="details-row fields">\n      <span class="details-label">\n        Field(s) where Personally Identifiable Information (PII) was found: \n      </span>\n      {{:: $ctrl.formatFieldsWithPii($ctrl.request.fieldsWithPiiData) }}\n    </div>\n    <div class="details-row examples">\n      <div class="details-label">\n        Example(s) of PII sent:\n      </div>\n      <ul class="details-list">\n        <li ng-repeat="example in ::$ctrl.request.examples">{{::example}}</li>\n      </ul>\n    </div>\n    <div class="details-row type">\n      <div class="details-label">\n        Type of Personally Identifiable Information (PII) found:\n      </div>\n      <ul class="details-list">\n        <li ng-repeat="type in ::$ctrl.request.typesOfPii">\n          {{::type|piiDataDeletionTypeOfPii}}\n        </li>\n        <li ng-if="::$ctrl.request.customPiiType">{{::$ctrl.request.customPiiType}}</li>\n      </ul>\n    </div>\n    <div class="details-row date-first">\n      <span class="details-label">\n        Date of first PII sent:\n      </span>\n      {{ ::$ctrl.request.startDate | fromISONumber | date : \'mediumDate\' }}\n    </div>\n    <div class="details-row date-last">\n      <span class="details-label">\n        Date of last PII sent:\n      </span>\n      <span ng-if="::$ctrl.request.endDate">\n        {{ ::$ctrl.request.endDate | fromISONumber | date : \'mediumDate\' }}\n      </span>\n      <span ng-if="::!$ctrl.request.endDate">\n        ongoing\n      </span>\n    </div>\n    <div class="details-row status">\n      <span class="details-label">Status:</span>\n      {{::$ctrl.request.status|piiDataDeletionRequestStatus}}\n    </div>\n  </section>\n\n  <section>\n    <header class="subtitle">\n      Action required\n    </header>\n    <p>\n      Click <b>Approve</b> if you acknowledge that you are <a answer-id="6366371" ga-learn-more="">no longer sending PII</a> and approve the data deletion request. All of the data within the columns that contain the PII (these fields are listed above) will be deleted for the given date range. \n    </p>\n    <p>\n      You can click <b>Object</b> if you do not believe this request is valid (for example, if the date range is incorrect or you do not believe the fields actually contain PII). You will then see a pop-up text box where you can explain your objection, and the Google Trust and Safety team will respond with next steps via email. \n    </p>\n    <p>\n      In order to protect user privacy, a response is required within <b>30 days</b> of the Notification date listed above. Failure to respond in a timely manner may result in Google deleting the entire field for the date ranges listed. \n    </p>\n    <ga-checkbox name="acknowledgement"\n                 ng-model="$ctrl.acknowledgeNoSendingPii"\n                 ng-change="$ctrl.hideObjectionEditor()"\n                 disabled="!$ctrl.isAwaitingAdminResponse()">\n      I acknowledge that our property is no longer sending PII to Google.\n    </ga-checkbox>\n    <div class="ga-error-label"\n         ng-show="$ctrl.acknowledgementRequired && !$ctrl.acknowledgeNoSendingPii">\n      You must check this box before approving.\n    </div>\n    <div>\n      <button class="btn share"\n              ng-disabled="!$ctrl.isAwaitingAdminResponse()"\n              ng-click="$ctrl.approveRequest()">\n        Approve\n      </button>\n      <button class="btn create"\n              ng-disabled="!($ctrl.isAwaitingAdminResponse() || $ctrl.isInGracePeriod())"\n              ng-click="$ctrl.showObjectionEditor()">\n        Object\n      </button>\n    </div>\n    <div ng-show="$ctrl.isObjectionEditorVisible">\n      <ga-textarea name="objectionText" is-required="true"\n                   text="$ctrl.objectionReason" class="objectionText"></ga-textarea>\n      <div class="btn-group">\n        <button class="btn action" ng-click="editForm.$valid && $ctrl.objectRequest()">\n          Submit\n        </button>\n        <button class="btn" ng-click="$ctrl.hideObjectionEditor()">\n          Cancel\n        </button>\n      </div>\n    </div>\n    <div class="piidatadeletion-confirmation" ng-show="$ctrl.isRequestApproved()">\n      <span class="icon-approved"></span>\n      <span>\n        An admin on this property has <b>approved</b> the data deletion request.\n      </span>\n    </div>\n    <div class="piidatadeletion-confirmation" ng-show="$ctrl.isRequestObjected()">\n      An admin on this property has <b>objected</b> to the data deletion request.\n      <p>\n        <span>Objection reason:</span>\n        <span class="objection-reason">{{$ctrl.request.objectionReason}}</span>\n      </p>\n    </div>\n  </section>\n  <section>\n    <header class="subtitle">\n      What\u2019s next?\n    </header>\n    <p>\n      If you approved, all property admins will receive an email and will have 7 days to review the approval. After this grace period, Google will verify that PII is no longer being sent and delete any fields with PII.<br/><br/> If you objected, all admins will receive an email confirming the objection. Google will review your justification and provide further communication regarding a resolution.\n    </p>\n  </section>\n  <button class="btn" ng-click="$ctrl.goToTable()">\n    Done\n  </button>\n</form>\n<form name="editForm" novalidate class="piidatadeletion-editor" ng-if="::$ctrl.newPiiDeletionEnabled">\n  <header class="title">\n    Data Deletion Request review\n  </header>\n\n  <section>\n    <header class="subtitle">\n      Data Deletion Request details\n    </header>\n    <div class="details-row tracking-id">\n      <span class="details-label">\n        Tracking ID:\n      </span>\n      {{::$ctrl.trackingId}}\n    </div>\n    <div class="details-row request-id">\n      <span class="details-label">Incident ID:</span>\n      {{::$ctrl.request.requestId}}\n    </div>\n    <div class="details-row created-by">\n      <span class="details-label">\n        Created by:\n      </span>\n      {{ ::$ctrl.creatorMsg }}\n    </div>\n    <div class="details-row modified-by">\n      <span class="details-label">\n        Last modified by:\n      </span>\n      {{ ::$ctrl.modifierMsg }}\n    </div>\n    <div class="details-row notification-date">\n      <span class="details-label">\n        Date created:\n      </span>\n      {{ ::$ctrl.request.notificationDate | fromISONumber | date : \'mediumDate\' }}\n    </div>\n    <div class="details-row canceled-date" ng-if="::$ctrl.isCanceled()">\n      <span class="details-label">\n        Date canceled:\n      </span>\n      {{ ::$ctrl.request.lastModifiedDateMilliseconds | date : \'mediumDate\' }}\n    </div>\n    <div class="details-row fields">\n      <span class="details-label">\n        Field(s) specified for deletion:\n      </span>\n      {{:: $ctrl.formatFieldsWithPii($ctrl.request.fieldsWithPiiData) }}\n    </div>\n    <div class="details-row date-first">\n      <span class="details-label">\n        Start Date (inclusive):\n      </span>\n      {{ ::$ctrl.request.startDate | fromISONumber | date : \'mediumDate\' }}\n    </div>\n    <div class="details-row date-last">\n      <span class="details-label">\n        End Date (inclusive):\n      </span>\n      <span ng-if="::$ctrl.request.endDate">\n        {{ ::$ctrl.request.endDate | fromISONumber | date : \'mediumDate\' }}\n      </span>\n    </div>\n    <div class="details-row status">\n      <span class="details-label">Status:</span>\n      {{::$ctrl.request.status|piiDataDeletionRequestStatus}}\n    </div>\n  </section>\n  <div ng-if="$ctrl.isInGracePeriod()">\n    <section>\n      <header class="subtitle">\n        Available Actions\n      </header>\n      <p>\n        Click <b>Cancel Deletion</b> if you wish to halt this data deletion for any reason. You may do this at any time prior to deletion taking place. There is no ability to amend or update an existing Data Deletion Request. If the information here is inaccurate, then you should cancel this deletion and create a new one with the correct information. \n      </p>\n      <div>\n        <button class="btn create cancel-button"\n                ng-click="$ctrl.cancelRequest()">\n          Cancel Deletion\n        </button>\n      </div>\n    </section>\n    <section>\n      <header class="subtitle">\n      What\u2019s next?\n      </header>\n      <p>\n        There is no action required. In order to give admins an opportunity to review, pending deletions will occur no sooner than 7 days from the day they were requested, but may occur at any point after 7 days have elapsed. If you wish to correct or cancel this deletion, please review the section above.\n      </p>\n    </section>\n  </div>\n  <button class="btn done-button" ng-click="$ctrl.goToTable()">\n    Done\n  </button>\n</form>\n'),
a.put("/analytics/app/activities/admin/piidatadeletion/table/piidatadeletion-table.html",'<div class="piidatadeletion-table-container">\n  <p>\n    In order to protect user privacy, Google\u2019s policies prohibit Personally Identifiable Information (PII) to be sent to our systems. If PII is found, Google may need to delete data from certain fields associated with your Google Analytics property. Before we delete data, Google generates a Data Deletion Request to give you an opportunity to review the PII that was found, make changes to your property to <a answer-id="6366371" ga-learn-more="">avoid sending Google PII</a>, or object if you believe the request is invalid.\n  </p>\n  <div class="piidatadeletion-create-container" ng-if="$ctrl.canCreateDDR">\n    <piidatadeletion-create-button (create)="$ctrl.reloadTable()"\n                                   [create-disabled]="$ctrl.isCreateDisabled()">\n    </piidatadeletion-create-button>\n  </div>\n  <ga-table name="piiDataDeletionTable"\n            ng-if="$ctrl.tableData"\n            class="piidatadeletion-table"\n            search-enabled="true"\n            sort-enabled="true"\n            sort-descending="true"\n            default-sort-column-id="notificationDate"\n            blacklisted-search-keys="[\'requestId\']">\n    <table>\n      <tr header-template>\n        <th ga-sortable-header-cell sort-key="requestId" class="header-request-id" role="columnheader">\n          Incident ID\n        </th>\n        <th ga-sortable-header-cell sort-key="notificationDate" role="columnheader">\n          Date Created\n        </th>\n        <th ga-sortable-header-cell sort-key="fieldsWithPiiData" role="columnheader">\n          Field where Personally Identifiable Information (PII) was found\n        </th>\n        <th ga-sortable-header-cell sort-key="status" role="columnheader">\n          Status\n        </th>\n      </tr>\n      <tr row-template>\n        <td class="ga-table-link-cell">\n          <a class="ga-table-edit-style-link" ng-bind="::rowData.requestId"\n             ui-sref="{{\'app.admin.piidatadeletion.edit({requestId:rowData.requestId})\'}}">\n          </a>\n        </td>\n        <td>{{ ::rowData.notificationDate | fromISONumber | date : \'mediumDate\' }}</td>\n        <td>\n          <span ng-if="::rowData.fieldsWithPiiData">\n            {{:: $ctrl.formatFieldsWithPii(rowData.fieldsWithPiiData) }}</span>\n        </td>\n        <td>\n          <div ng-class="{\'action-required\': rowData.actionRequired}">\n            {{::rowData.status | piiDataDeletionRequestStatus}}\n          </div>\n        </td>\n      </tr>\n    </table>\n  </ga-table>\n</div>\n'),
a.put("/analytics/app/activities/admin/property/settings/property_settings/property-settings.html",['<form name="form" novalidate ng-if="!ctrl.isLinkedToScion">\n  <h1 class="title">\n    Property Settings\n    <span class="inline-block pull-right" ng-show="::ctrl.canEdit">\n      <button\n        class="btn"\n        ui-sref="app.admin.property.move"\n        type="button"\n        ng-if="ctrl.canMoveProperty"\n      >\n        Move property\n      </button>\n      <button class="btn" ui-sref="app.admin.property.delete" type="button">\n        Move to Trash Can\n      </button>\n    </span>\n  </h1>\n\n  <section>\n    <h2 class="subtitle">Basic Settings</h2>\n\n    <div class="ga-form-item">\n      <div class="label">Tracking Id</div>\n      <div class="content tracking-id-container">\n        <div ng-if="ctrl.property.isPremium" class="premium-icon-container">\n          <ga-premium-icon></ga-premium-icon>\n          <div class="tracking-id-text">{{ ctrl.trackingId }}</div>\n        </div>\n        <div ng-if="!ctrl.property.isPremium">{{ ctrl.trackingId }}</div>\n      </div>\n    </div>\n\n    <div class="ga-form-item">\n      <div class="label" ng-attr-id="{{ ctrl.gaPropertyNameId }}">\n        Property Name\n      </div>\n      <div class="content">\n        <input\n          type="text"\n          name="name"\n          ng-disabled="::!ctrl.canEdit"\n          required\n          ng-maxlength="255"\n          ng-model="ctrl.property.propertyName"\n          class="galaxy-input medium"\n          ng-attr-aria-labelledby="{{ ctrl.gaPropertyNameId }}"\n        />\n      </div>\n      <ga-error-label targets="name"></ga-error-label>\n    </div>\n\n    <div class="ga-form-item" ng-if="ctrl.property.isWeb">\n      <div class="label">Default URL</div>\n      <div class="content">\n        <ga-url-selector\n          name="defaultUrl"\n          required\n          maxlength="255"\n          ng-model="ctrl.property.defaultWebsiteUrl"\n          disabled="::!ctrl.canEdit"\n        ></ga-url-selector>\n      </div>\n      <ga-error-label targets="defaultUrl">\n        <ga-error-label-msg catches="validUrl">\n          Default URL is invalid.\n        </ga-error-label-msg>\n      </ga-error-label>\n    </div>\n\n    <div class="ga-form-item">\n      <div class="label">Default View</div>\n      <div class="content">\n        <ga-account-tree-picker\n          name="defaultViewId"\n          required\n          type="view"\n          single-select="true"\n          ng-model="ctrl.property.defaultViewId"\n          disabled="::!ctrl.canEdit"\n        ></ga-account-tree-picker>\n      </div>\n      <ga-error-label targets="defaultViewId"></ga-error-label>\n    </div>\n\n    <div class="ga-form-item">\n      <div class="label">\n        Industry Category\n      </div>\n      <div class="content">\n        <ga-industry-selector\n          ng-model="ctrl.property.industryVertical"\n          disabled="::!ctrl.canEdit"\n        ></ga-industry-selector>\n      </div>\n    </div>\n\n    <jfk-zippy class="ga-form-item ga-property-advanced-settings">\n      <div class="label">Advanced Settings</div>\n      <div class="content">\n        <ga-checkbox\n          ng-model="ctrl.property.manualTaggingOverride"\n          disabled="::!ctrl.canEdit"\n        >\n          Allow manual tagging (UTM values) to override auto-tagging (GCLID values) for Google Ads and Search Ads 360 integration\n          <ga-help-tooltip-ng1 topic-id="3310516"></ga-help-tooltip-ng1>\n        </ga-checkbox>\n        <ga-checkbox\n          ng-model="ctrl.property.dcManualTaggingOverride"\n          ng-if="ctrl.dcManualTaggingEnabled"\n          disabled="::!ctrl.canEdit"\n        >\n          Allow manual tagging (UTM values) to override auto-tagging (DCLID values) for Campaign Manager 360 and Display &amp; Video 360 reporting integration\n          <ga-help-tooltip-ng1 topic-id="6256626"></ga-help-tooltip-ng1>\n        </ga-checkbox>\n      </div>\n    </jfk-zippy>\n  </section>\n  <section>\n    <h2 class="subtitle">\n      Property Hit Volume\n    </h2>\n\n    <div ng-if="!ctrl.hitVolume">\n      <ga-progress-circular class="hits-loader" ng-if="!ctrl.hitsUnavailable">\n      </ga-progress-circular>\n      <p ng-if="ctrl.hitsUnavailable">\n        Hit volumes are currently unavailable because of an error.\n      </p>\n    </div>\n    <div ng-if="ctrl.hitVolume">\n      <p>\n        <strong>Last day</strong>: {{ctrl.getHitsMsg(ctrl.hitVolume.hitsDay)}} \n      </p>\n      <p>\n        <strong>Last 7 Days</strong>: {{ctrl.getHitsMsg(ctrl.hitVolume.hitsWeek)}}\n      </p>\n      <p>\n        <strong>Last 30 Days</strong>: {{ctrl.getHitsMsg(ctrl.hitVolume.hitsMonth) }}\n      </p>\n      <p\n        ng-if="ctrl.hitVolume.warningLevel === 1"\n        class="ga-property-hit-volume-warning"\n      >\n        <strong>Warning!</strong> You are exceeding our limit of the allowed volume of 10M hits/month to this property, as outlined in our Terms of Service. If you continue to exceed our hit limit, you will lose access to this data. <a answer-id="1070983" ga-learn-more="">Learn more</a> about possible solutions.\n      </p>\n      <p\n        ng-if="ctrl.hitVolume.warningLevel === 2"\n        class="ga-property-hit-volume-warning"\n      >\n        <strong>Warning!</strong> You are exceeding our limit of the allowed volume of 10M hits/month to this property, as outlined in our Terms of Service. If you continue to exceed our hit limit, you will lose access to this data. <a answer-id="1070983" ga-learn-more="">Learn more</a> about possible solutions.\n      </p>\n      <p\n        ng-if="ctrl.hitVolume.warningLevel === 3"\n        class="ga-property-hit-volume-warning"\n      >\n        <strong>Warning!</strong> You have exceeded our data limits, as outlined in our Terms of Service. We are no longer processing hits for this property. <a answer-id="1070983" ga-learn-more="">Learn more</a> about possible solutions.\n      </p>\n    </div>\n  </section>\n  <section ng-if="!ctrl.gaiaCollectionEnabled && !ctrl.isWave2UaDeprecationEnabled">\n    <h2 class="subtitle">\n      Advertising Features\n    </h2>\n\n    <div class="ga-form-item guided-help-demographics-settings">\n      <div class="label">\n        Enable Demographics and Interest Reports\n        <ga-help-tooltip-ng1 topic-id="3134686"></ga-help-tooltip-ng1>\n      </div>\n      <div class="desc">\n        Demographics and Interest Reports make Age, Gender, and Interest data available so you can better understand who your users are.\n      </div>\n      <div class="content">\n        <ga-toggle-switch\n          ng-model="ctrl.property.demographicsEnabled"\n          disabled="::!ctrl.canEdit"\n        ></ga-toggle-switch>\n      </div>\n    </div>\n  </section>\n\n  <section ng-if="ctrl.property.isApp">\n    <h2 class="subtitle">iOS Campaign Tracking</h2>\n\n    <div class="ga-form-item">\n      <div class="label">\n        Enable Campaign Tracking Features\n      </div>\n      <div class="desc">\n        iOS Campaign Tracking allows you to set up custom URLs to track the performance of your in-app advertising campaigns, so that you can better understand how different sources are driving users to your app. Follow these instructions to setup Campaign Tracking in your iOS app: <a answer-id="3369406" ga-learn-more=""> How to setup iOS Campaign Tracking on my app?</a> \n      </div>\n      <div class="content">\n        <ga-toggle-switch\n          ng-model="ctrl.property.iosCampaignTracking"\n          disabled="::!ctrl.canEdit"\n        ></ga-toggle-switch>\n      </div>\n    </div>\n  </section>\n\n  <section ng-if="ctrl.property.isWeb">\n    <h2 class="subtitle">In-Page Analytics</h2>\n\n    <div class="ga-form-item">\n      <div class="label">\n        Use enhanced link attribution\n      </div>\n      <div class="desc">\n        Enhanced link attribution allows us to better track links on your page, but requires a small change to the tracking code. Follow these instructions to setup enhanced link attribution on your site: <a answer-id="2558867" ga-learn-more=""> How to setup enhanced link attribution on my site?</a> \n      </div>\n      <div class="content">\n        <ga-toggle-switch\n          ng-model="ctrl.property.inPageEnableLinkId"\n          disabled="::!ctrl.canEdit"\n        ></ga-toggle-switch>\n      </div>\n    </div>\n\n    <div class="ga-form-item" ng-if="ctrl.property.isWeb">\n      <div class="label">\n        Start In-Page Analytics in\n      </div>\n      <div class="content">\n        <ga-radiobutton\n          ng-model="ctrl.property.inPageStartFullView"\n          value="false"\n          name="inPageStartFullView"\n          inline="false"\n          disabled="::!ctrl.canEdit"\n        >\n          Embedded mode (recommended)\n        </ga-radiobutton>\n        <ga-radiobutton\n          ng-model="ctrl.property.inPageStartFullView"\n          value="true"\n          name="inPageStartFullView"\n          inline="false"\n          disabled="::!ctrl.canEdit"\n        >\n          Full view mode\n        </ga-radiobutton>\n        <div>\n          Use of full view mode is recommended only if your site has trouble loading in embedded mode.\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section\n    class="search-history-delete"\n    ng-if="ctrl.showDeleteSearchHistoryControls"\n  >\n    <h2 class="subtitle">\n      Google Analytics Intelligence\n    </h2>\n    <div class="ga-form-item">\n      <div class="label">Search History</div>\n      <div class="desc">\n        Google Analytics Intelligence uses search history within Google Analytics to optimize searches and recommendations. To delete all of this property\'s search data, use the control below. Recent browsing data is saved in your browser.\n      </div>\n      <button class="btn" ng-click="ctrl.deleteSearchHistory()">\n        Delete Search History\n      </button>\n    </div>\n  </section>\n\n  <section ng-if="ctrl.property.isWeb">\n    <h2 class="subtitle">Search Console</h2>\n    <button class="btn" ui-sref="app.admin.integrations.wmx">\n      Adjust Search Console\n    </button>\n  </section>\n\n  <section>\n    <h2 class="subtitle">User Analysis</h2>\n    <div class="ga-form-item">\n      <div class="label">\n        Enable Users Metric in Reporting\n      </div>\n      <div class="desc">\n        Adds the Users metric to standard reports and updates your <a answer-id="2992042" ga-learn-more="">users metric calculation.</a>\n      </div>\n      <div class="content">\n        <ga-toggle-switch\n          ng-model="ctrl.property.userMetricsReportEnabled"\n          disabled="::!ctrl.canEdit"\n        ></ga-toggle-switch>\n      </div>\n    </div>\n  </section>\n\n  <ga-submit-buttons\n    no-submit-button="::!ctrl.canEdit"\n    submit="ctrl.submit()"\n    monitor-submit-action="PropertySettingsSubmit"\n    class="guided-help-property-settings-submit"\n  >\n  </ga-submit-buttons>\n</form>\n<div ng-if="ctrl.isLinkedToScion">\n  <div>\n    <img\n      class="firebase-image"\n      ga-static-src="static/admin/integrations/scion/firebase_logo_large.png"\n      alt\n    />\n    <span class="inline-block pull-right" ng-show="::ctrl.canEdit">\n      <button\n        id="firebase-delete-property"\n        class="btn"\n        ui-sref="app.admin.property.delete"\n        type="button"\n      >\n        Move to Trash Can\n      </button>\n    </span>\n  </div>\n  <div class="firebase-description">\n    <p>\n      Firebase is Google\'s mobile app developer platform and helps developers incorporate Google\'s mobile app services quickly and easily \u2013 including Google Analytics. Connect to Firebase to get started. Google Analytics for apps includes data for in-app behavioral events, audiences, conversions, attribution and lifetime value (LTV), funnels, and cohorts. You can delete this property at any time if you determine that you do not want the associated Firebase app available in Google Analytics.\n      <a\n        ga-learn-more\n        help-center="firebase"\n        topic-id="6317493"\n        aria-label="Learn more about Firebase features"\n        i18n-aria-label="a link to learn about Firebase features"\n      ></a>\n    </p>\n  </div>\n  <div\n    class="firebase-app"\n    ng-init="app = {\'text\': ctrl.property.propertyName, \'value\': ctrl.property.propertyName}"\n  >\n    <ga-select-dropdown',
