a.put("/analytics/app/activities/admin/integrations/dslinks/table/ds-copy-authorization-link-dialog.html",'<header class="ga-dialog-title">\n  <span ng-if="requestSent">\n    {{::dialogTitle}}\n  </span>\n  <span ng-if="!requestSent">\n    Copy Search Ads 360 authorization link\n  </span>\n</header>\n\n<section class="ga-dialog-content">\n  <p ng-if="requestSent">\n    {{::dialogSentMessage}}\n  </p>\n  <p ng-if="!requestSent">\n    {{::dialogExpiredMessage}}\n  </p>\n  <ul class="ds-copy-request-link-item">\n    <li ng-repeat="link in authorizationLinks track by $index">\n      <a href="{{link}}" target="_blank">{{link}}</a>\n    </li>\n  </ul>\n  <p ng-if="failedLinks.length > 0">\n    Creation of the following link(s) has failed:\n  </p>\n  <ul>\n    <li ng-repeat="failedLink in failedLinks track by $index">\n      {{failedLink.advertiserId}} / {{emailMap[failedLink.advertiserId]}}\n      <p ng-if="failedLink.error.message">{{failedLink.error.message}}</p>\n      <p ng-if="failedLink.error.code == errorCode.DS_ERROR_DUPLICATE">\n        Request with this advertiser already exists.\n      </p>\n    </li>\n  </ul>\n</section>\n\n<section class="ga-dialog-buttons">\n  <ga-button-ok ng-click="$confirm()"></ga-button-ok>\n</section>\n'),
a.put("/analytics/app/activities/admin/integrations/dslinks/table/ds-links-table.html",'<header class="title">\n  Search Ads 360 \n</header>\n\n<ga-table\n    rows="ctrl.linkRows"\n    search-enabled="true"\n    sort-enabled="true"\n    sort-function="ctrl.compareLinks"\n    default-sort-column-id="name"\n    blacklisted-search-keys="[\'views\', \'linkUid\']">\n  <div controls-template>\n    <button type="button" class="ga-table-action-button create-button"\n            ng-disabled="{{!ctrl.canCreateLink()}}"\n            ui-sref="app.admin.integrations.ds-links.create">\n      + New SA360 Link \n    </button>\n  </div>\n  <table>\n    <tr header-template>\n      <th ga-sortable-header-cell sort-key="name" class="ds-links-table-row-title">\n        Link title\n      </th>\n      <th ga-sortable-header-cell sort-key="agencyId">\n        Agency Id\n      </th>\n      <th ga-sortable-header-cell sort-key="advertiserId">\n        Advertiser Id\n      </th>\n      <th ga-sortable-header-cell sort-key="views">\n        Linked views\n      </th>\n    </tr>\n    <tr row-template>\n      <td>\n        <a ui-sref="app.admin.integrations.ds-links.edit({ linkUid: rowData.linkUid })"\n           ng-bind="::ctrl.renderName(rowData)"></a>\n      </td>\n      <td ng-bind="::rowData.agencyId"></td>\n      <td ng-bind="::rowData.advertiserId"></td>\n      <td>\n        <ga-account-tree-picker\n            type="view"\n            exclude-trashed="true"\n            single-select="false"\n            ng-model="rowData.views"\n            on-close="ctrl.onAccountPickerClose(rowData)"\n            disabled="!ctrl.canEdit"\n            data-link-uid="{{ rowData.linkUid }}"></ga-account-tree-picker>\n      </td>\n    </tr>\n  </table>\n</ga-table>\n\n<div ng-if="ctrl.requestRows.length > 0">\n  <h4 class="ds-requests-header">\n    Pending requests\n  </h4>\n\n  <ga-table\n      rows="ctrl.requestRows"\n      search-enabled="true"\n      sort-enabled="true"\n      sort-function="ctrl.compareRequests"\n      default-sort-column-id="requestDate"\n      sort-descending="true"\n      blacklisted-search-keys="[\'authorizationUid\']">\n    <table>\n      <tr header-template>\n        <th ga-sortable-header-cell sort-key="requestDate"\n            class="ds-requests-table-row-date">\n          Request date\n        </th>\n        <th ga-sortable-header-cell sort-key="advertiserId"\n            class="ds-requests-table-row-advertiser-id">\n          Advertiser Id\n        </th>\n        <th ga-sortable-header-cell sort-key="advertiserName"\n            class="ds-requests-table-row-advertiser">\n          Advertiser Name\n        </th>\n        <th ga-sortable-header-cell sort-key="status"\n            class="ds-requests-table-row-status">\n          Link Status\n        </th>\n        <th ga-sortable-header-cell sort-key="approverComment"\n            class="ds-requests-table-row-comment">\n          Comment\n        </th>\n        <th class="ds-requests-table-row-actions">\n          Actions\n        </th>\n      </tr>\n      <tr row-template>\n        <td>{{ rowData.requestDate | date : \'mediumDate\' }}</td>\n        <td ng-bind="::rowData.advertiserId"></td>\n        <td ng-bind="::rowData.advertiserName"></td>\n        <td class="ds-requests-table-row-status-data">\n          <span ng-if="::rowData.status == ctrl.STATUS_TYPE.UNKNOWN">\n            Unknown\n          </span>\n          <span ng-if="::rowData.status == ctrl.STATUS_TYPE.PROPOSED">\n            Pending Approval\n          </span>\n          <span ng-if="::rowData.status == ctrl.STATUS_TYPE.APPROVED">\n            Approved\n          </span>\n          <span ng-if="::rowData.status == ctrl.STATUS_TYPE.REJECTED">\n            Rejected\n          </span>\n          <span ng-if="::rowData.status == ctrl.STATUS_TYPE.WITHDRAWN">\n            Withdrawn\n          </span>\n        </td>\n        <td ng-bind="::rowData.approverComment"></td>\n        <td class="ds-requests-table-row-actions-data">\n          <button type="button" class="btn ds-request-button-delete"\n                  ng-if="ctrl.canDeleteRequest(rowData)"\n                  ng-click="ctrl.deleteRequestDialog(rowData)">\n            Withdraw\n          </button>\n          <button type="button" class="btn ds-request-button-copy"\n                  ng-if="ctrl.canCopyRequestLink(rowData)"\n                  ng-click="ctrl.displayCopyRequestLinkDialog(rowData)">\n            Copy Link\n          </button>\n          <button type="button" class="btn share ds-request-button-complete"\n                  ng-if="ctrl.canCompleteRequest(rowData)"\n                  ui-sref="app.admin.integrations.ds-links.complete({\n                    authorizationUid: rowData.authorizationUid\n                  })">\n            Complete link\n          </button>\n        </td>\n      </tr>\n    </table>\n  </ga-table>\n</div>\n'),
a.put("/analytics/app/activities/admin/integrations/dslinks/title/ds-links-title.html",'<div class="ds-links-title">\n  <div class="ga-form-item">\n    <div class="desc" id="ds_link_title">\n      <strong>\n        Link title\n      </strong>\n      <ga-help-tooltip-ng1 topic-id="{{::ctrl.helpTopic.SELF_SERVE_LINK_TITLE}}"></ga-help-tooltip-ng1>\n    </div>\n    <div class="content">\n      <input type="text"\n             name="title"\n             ng-model="$ctrl.linkTitle"\n             aria-labelledby="ds_link_title"\n             ng-disabled="$ctrl.disabled"\n             required\n             class="galaxy-input"/>\n    </div>\n    <ga-error-label targets="title"></ga-error-label>\n  </div>\n</div>\n'),
a.put("/analytics/app/activities/admin/integrations/sfmc/editor/sfmc-editor.html",'<header class="title">\n  Configure Salesforce Marketing Cloud Link\n</header>\n<p>\n  Linking accounts enables authorized Analytics and Salesforce Marketing Cloud users to see data from both products.\n</p>\n\n<ga-wizard back-sref="app.admin.integrations.sfmc.table"\n           read-only="::ctrl.disabled"\n           on-save="ctrl.onSaveLink()"\n           initially-completed="!ctrl.isNewLink()">\n  <steps>\n    <ga-wizard-step continue-disabled="!ctrl.currentLink.salesforceInfo">\n      <step-title>\n        Link a Salesforce Marketing Cloud account\n      </step-title>\n      <step-summary>\n        Enterprise ID: {{ctrl.currentLink.salesforceInfo.sfmcEnterpriseId}}\n        <br>\n        Enterprise Name: {{ctrl.currentLink.salesforceInfo.sfmcName}}\n      </step-summary>\n      <step-body>\n        <div ng-if="ctrl.currentLink.salesforceInfo.sfmcEnterpriseId">\n          Enterprise ID: {{ctrl.currentLink.salesforceInfo.sfmcEnterpriseId}}\n          <br>\n          Enterprise Name: {{ctrl.currentLink.salesforceInfo.sfmcName}}\n        </div>\n        <div ng-if="!ctrl.currentLink.salesforceInfo.sfmcEnterpriseId">\n          <md-button class="md-raised md-primary" ng-click="ctrl.loginButtonClicked()">\n            Login to Salesforce Marketing Cloud\n          </md-button>\n        </div>\n      </step-body>\n    </ga-wizard-step>\n    <ga-wizard-step>\n      <step-title>\n        Link configuration\n      </step-title>\n      <step-summary>\n        Link name: {{ctrl.currentLink.name}}\n      </step-summary>\n      <step-body>\n        <div class="ga-form-item">\n          <div class="label">\n            Link name\n          </div>\n          <div class="content">\n            <input type="text"\n                   name="linkName"\n                   ng-disabled="ctrl.disabled"\n                   required ng-maxlength="255"\n                   ng-model="ctrl.currentLink.name"\n                   placeholder="e.g., My Company\'s SFMC Account"\n                   class="galaxy-input medium" />\n            <ga-help-tooltip-ng1 topic-id=""></ga-help-tooltip-ng1>\n          </div>\n          <ga-error-label targets="linkName">\n            <ga-error-label-msg catches="required">\n              Enter a link name.\n            </ga-error-label-msg>\n          </ga-error-label>\n        </div>\n      </step-body>\n    </ga-wizard-step>\n  </steps>\n  <extra-global-buttons>\n    <a class="delete-link"\n       ng-if="::!ctrl.disabled && !ctrl.isNewLink()"\n       ng-click="ctrl.deleteLink()">\n      Delete link\n    </a>\n  </extra-global-buttons>\n  <whats-next>\n    <a class="delete-link"\n       ng-if="!ctrl.disabled && !ctrl.isNewLink()"\n       ng-click="ctrl.deleteLink()">\n      Delete link\n    </a>\n    <h1>\n      What\'s next?\n    </h1>\n    <p>\n      It may take up to 24 hours for your Salesforce Marketing Cloud link to begin displaying data.\n    </p>\n    <section class="sfmc-whtnext">\n      <h2>\n        Create a Messaging Audience in Analytics\n      </h2>\n      <p> Messaging with Google Analytics lets you segment your audience of past site users and deliver relavant emails in Salesforce Marketing Cloud journeys based on the actions people have taken on your site. </p> <p> Take advantage of Analytics data to identify those users\' interests (e.g., which product pages they visited) and build audiences focused on those users and their behaviors. </p>\n    </section>\n  </whats-next>\n</ga-wizard>\n'),
a.put("/analytics/app/activities/admin/integrations/sfmc/editor/dialogs/sfmc-delete-dialog.html",'<section class="ga-dialog-title">\n  Are you sure you want to delete this link?\n</section>\n<section class="ga-dialog-content owned-by-user">\n  Unlinking this salesforce link from Analytics will stop all data flowing between Salesforce and Analytics property. \n</section>\n<section class="ga-dialog-buttons">\n  <ga-button-delete ng-click="$confirm()"></ga-button-delete>\n  <ga-button-cancel ng-click="$cancel()"></ga-button-cancel>\n</section>\n'),
